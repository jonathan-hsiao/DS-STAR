#!/usr/bin/env python3
"""
inspect_discounts.py

Loads and describes the content of data/discounts.csv.

- Handles both structured (CSV table) and "unstructured-ish" CSV (single column, messy rows) by
  printing a raw preview plus a parsed preview.
- Prints essential info: file size, encoding guess, delimiter guess, column names, dtypes, missingness.
- If the dataset is large, prints only a few examples (head/tail/sample).
- Self-contained single-file program. No try/except by request.
"""

from pathlib import Path
import csv

import pandas as pd


DATA_DIR = Path("data")
CSV_PATH = DATA_DIR / "discounts.csv"
PREVIEW_LINES = 30          # raw file preview lines
MAX_PRINT_ROWS = 20         # max rows to print in table previews
SAMPLE_ROWS = 10            # sample rows for large datasets
TOP_N_VALUE_COUNTS = 10     # for categorical columns


def read_text_prefix(path: Path, nbytes: int = 200_000) -> bytes:
    with path.open("rb") as f:
        return f.read(nbytes)


def guess_encoding(raw: bytes) -> str:
    # Simple, pragmatic heuristic without external deps:
    # - try utf-8-sig, then utf-8, then cp1252, then latin1.
    for enc in ("utf-8-sig", "utf-8", "cp1252", "latin1"):
        raw.decode(enc)
        return enc
    return "utf-8"  # fallback (should not be reached)


def guess_dialect(sample_text: str):
    sniffer = csv.Sniffer()
    # Candidate delimiters typical for "CSV" exports.
    dialect = sniffer.sniff(sample_text, delimiters=[",", ";", "\t", "|"])
    has_header = sniffer.has_header(sample_text)
    return dialect, has_header


def print_section(title: str):
    print("\n" + "=" * 80)
    print(title)
    print("=" * 80)


def safe_repr(s: str, max_len: int = 240) -> str:
    s = s.replace("\r\n", "\n").replace("\r", "\n")
    if len(s) <= max_len:
        return s
    return s[: max_len - 3] + "..."


def main():
    # Basic file info
    print_section("FILE INFO")
    print(f"Path: {CSV_PATH.resolve()}")
    print(f"Exists: {CSV_PATH.exists()}")

    # Ensure the path is correct before calling stat()/opening.
    # No try/except by request, so use assertions.
    assert CSV_PATH.exists(), (
        f"Missing file: {CSV_PATH.resolve()}\n"
        f"Current working directory: {Path.cwd()}\n"
        f"Expected location: data/discounts.csv"
    )
    assert CSV_PATH.is_file(), f"Not a file: {CSV_PATH.resolve()}"

    size = CSV_PATH.stat().st_size
    print(f"Size (bytes): {size:,}")

    raw_prefix = read_text_prefix(CSV_PATH)
    encoding = guess_encoding(raw_prefix)
    print(f"Encoding (heuristic): {encoding}")

    # Raw preview
    text_prefix = raw_prefix.decode(encoding, errors="strict")
    lines = text_prefix.splitlines()
    print_section(f"RAW PREVIEW (first {min(PREVIEW_LINES, len(lines))} lines from file prefix)")
    for i, line in enumerate(lines[:PREVIEW_LINES], start=1):
        print(f"{i:>3}: {safe_repr(line)}")

    # Dialect guess from a larger text sample (keep it modest)
    sample_text = text_prefix
    dialect, has_header = guess_dialect(sample_text)
    delim = dialect.delimiter
    print_section("CSV PARSING GUESS")
    print(f"Guessed delimiter: {repr(delim)}")
    print(f"Guessed quotechar: {repr(dialect.quotechar)}")
    print(f"Guessed escapechar: {repr(dialect.escapechar)}")
    print(f"Guessed doublequote: {dialect.doublequote}")
    print(f"Guessed skipinitialspace: {dialect.skipinitialspace}")
    print(f"Has header (heuristic): {has_header}")

    # Load with pandas
    # Use python engine for flexibility with odd CSVs. Don't suppress errors.
    df = pd.read_csv(
        CSV_PATH,
        sep=delim,
        engine="python",
        encoding=encoding,
    )

    print_section("DATAFRAME OVERVIEW")
    print(f"Shape: {df.shape[0]:,} rows x {df.shape[1]:,} columns")

    # Column names
    print_section("COLUMN NAMES")
    for idx, col in enumerate(df.columns, start=1):
        print(f"{idx:>3}: {col}")

    # dtypes and memory usage
    print_section("DTYPES & MEMORY USAGE")
    dtypes = df.dtypes.astype(str)
    mem = df.memory_usage(deep=True)
    summary = pd.DataFrame({"dtype": dtypes, "memory_bytes": mem.iloc[1:].values}, index=df.columns)
    summary["memory_bytes"] = summary["memory_bytes"].astype("int64")
    summary["memory_MB"] = summary["memory_bytes"] / (1024 ** 2)
    print(summary.sort_values(["memory_bytes"], ascending=False).to_string())

    # Missingness
    print_section("MISSING VALUES")
    na_counts = df.isna().sum()
    na_pct = (na_counts / len(df) * 100).round(2) if len(df) else na_counts.astype(float)
    miss = pd.DataFrame({"missing_count": na_counts, "missing_pct": na_pct})
    miss_nonzero = miss[miss["missing_count"] > 0].sort_values(["missing_count"], ascending=False)
    if len(miss_nonzero) == 0:
        print("No missing values detected by pandas (NaN).")
    else:
        print(miss_nonzero.to_string())

    # Basic describe (numeric + non-numeric)
    print_section("DESCRIBE (NUMERIC)")
    num_desc = df.describe(include="number").transpose()
    if len(num_desc) == 0:
        print("No numeric columns detected.")
    else:
        print(num_desc.to_string())

    print_section("DESCRIBE (NON-NUMERIC)")
    obj_desc = df.describe(include=["object", "string", "category"]).transpose()
    if len(obj_desc) == 0:
        print("No non-numeric (object/string/category) columns detected.")
    else:
        max_cols = 30
        if obj_desc.shape[0] > max_cols:
            print(obj_desc.head(max_cols).to_string())
            print(f"\n... ({obj_desc.shape[0] - max_cols} more non-numeric columns not shown)")
        else:
            print(obj_desc.to_string())

    # Value counts for a few categorical-looking columns (top N)
    print_section("TOP VALUE COUNTS (up to a few columns)")
    candidate_cols = []
    for col in df.columns:
        s = df[col]
        if s.dtype == "object":
            non_null = s.dropna().astype(str)
            avg_len = non_null.map(len).mean() if len(non_null) > 0 else 0
            nunique = s.nunique(dropna=True)
            if nunique <= 50 or (nunique <= 200 and avg_len <= 40):
                candidate_cols.append(col)

    candidate_cols = candidate_cols[:5]
    if not candidate_cols:
        print("No obvious categorical columns selected for value counts.")
    else:
        for col in candidate_cols:
            print(f"\n-- {col} (top {TOP_N_VALUE_COUNTS}) --")
            print(df[col].value_counts(dropna=False).head(TOP_N_VALUE_COUNTS).to_string())

    # Content printing: show head/tail/sample depending on size
    print_section("CONTENT PREVIEW (parsed table)")
    if len(df) <= MAX_PRINT_ROWS:
        print(df.to_string(index=False))
    else:
        print(f"Showing first {MAX_PRINT_ROWS} rows:")
        print(df.head(MAX_PRINT_ROWS).to_string(index=False))
        print(f"\nShowing last {min(MAX_PRINT_ROWS, len(df))} rows:")
        print(df.tail(min(MAX_PRINT_ROWS, len(df))).to_string(index=False))

        print(f"\nShowing a random sample of {min(SAMPLE_ROWS, len(df))} rows:")
        print(df.sample(n=min(SAMPLE_ROWS, len(df)), random_state=42).to_string(index=False))

    # Also print raw CSV rows using csv module for a small number of records (helps if parsing issues)
    print_section("RAW CSV ROWS (csv module preview)")
    with CSV_PATH.open("r", encoding=encoding, newline="") as f:
        reader = csv.reader(f, delimiter=delim, quotechar=dialect.quotechar)
        for i, row in enumerate(reader):
            if i >= 25:
                print("... (more rows not shown)")
                break
            print(row)

    print_section("DONE")


if __name__ == "__main__":
    main()
