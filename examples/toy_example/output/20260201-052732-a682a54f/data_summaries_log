#!/usr/bin/env python3
import os
import csv
from datetime import datetime

import pandas as pd


def is_mostly_numeric(series: pd.Series, threshold: float = 0.8) -> bool:
    s = series.dropna()
    if len(s) == 0:
        return False
    numeric = pd.to_numeric(s.astype(str).str.replace(",", "", regex=False), errors="coerce")
    return numeric.notna().mean() >= threshold


def safe_preview_dataframe(df: pd.DataFrame, max_rows: int = 10) -> str:
    with pd.option_context(
        "display.max_columns", 200,
        "display.width", 200,
        "display.max_colwidth", 80,
    ):
        return df.head(max_rows).to_string(index=False)


def describe_structured(df: pd.DataFrame, filename: str) -> None:
    print("\n=== Structured data detected (tabular) ===")
    print(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")

    print("\nColumn names:")
    for i, c in enumerate(df.columns, 1):
        print(f"  {i:>3}. {c}")

    print("\nDtypes:")
    print(df.dtypes.to_string())

    print("\nMissing values per column (count / %):")
    miss = df.isna().sum()
    miss_pct = (miss / max(len(df), 1) * 100).round(2)
    miss_table = pd.DataFrame({"missing_count": miss, "missing_pct": miss_pct}).sort_values(
        ["missing_count", "missing_pct"], ascending=False
    )
    print(miss_table.to_string())

    numeric_like_cols = [c for c in df.columns if is_mostly_numeric(df[c])]
    if numeric_like_cols:
        print("\nNumeric-like columns summary (converted with pd.to_numeric):")
        num_df = df[numeric_like_cols].copy()
        for c in numeric_like_cols:
            num_df[c] = pd.to_numeric(
                num_df[c].astype(str).str.replace(",", "", regex=False),
                errors="coerce",
            )
        desc = num_df.describe(include="all").T
        print(desc.to_string())

    print("\nSample value counts for low-cardinality columns (<= 20 unique, excluding NaN):")
    for c in df.columns:
        nun = df[c].nunique(dropna=True)
        if 1 <= nun <= 20:
            vc = df[c].value_counts(dropna=False).head(10)
            print(f"\n- {c} (unique={nun}) top values:")
            for k, v in vc.items():
                print(f"    {repr(k)}: {v}")

    n = len(df)
    if n <= 50:
        print(f"\n=== Full content of {filename} ===")
        print(safe_preview_dataframe(df, max_rows=n))
    else:
        print(f"\n=== Content preview of {filename} (too many rows; showing first 10 and last 10) ===")
        print("\n--- First 10 rows ---")
        print(safe_preview_dataframe(df, max_rows=10))
        print("\n--- Last 10 rows ---")
        print(df.tail(10).to_string(index=False))


def sniff_csv_dialect(path: str, sample_bytes: int = 65536):
    with open(path, "r", encoding="utf-8", newline="") as f:
        sample = f.read(sample_bytes)

    sniffer = csv.Sniffer()
    try:
        dialect = sniffer.sniff(sample)
        has_header = sniffer.has_header(sample)
    except csv.Error:
        # Fallback: comma-delimited, standard quoting
        dialect = csv.get_dialect("excel")
        has_header = True

    return dialect, has_header


def describe_unstructured_text(path: str, filename: str) -> None:
    print("\n=== Unstructured/line-based text detected ===")
    with open(path, "r", encoding="utf-8", newline="") as f:
        lines = f.read().splitlines()

    print(f"Total lines: {len(lines)}")
    non_empty = [ln for ln in lines if ln.strip() != ""]
    print(f"Non-empty lines: {len(non_empty)}")

    if non_empty:
        lengths = [len(ln) for ln in non_empty]
        print(
            f"Line length (non-empty): min={min(lengths)}, "
            f"max={max(lengths)}, avg={sum(lengths)/len(lengths):.1f}"
        )

        json_like = 0
        for ln in non_empty[:200]:
            s = ln.strip()
            if (s.startswith("{") and s.endswith("}")) or (s.startswith("[") and s.endswith("]")):
                json_like += 1
        print(f"JSON-like lines among first {min(200, len(non_empty))}: {json_like}")

    print(f"\n=== Content of {filename} (showing first 60 lines) ===")
    for i, ln in enumerate(lines[:60], 1):
        print(f"{i:>4}: {ln}")
    if len(lines) > 60:
        print(f"... ({len(lines)-60} more lines not shown)")


def main():
    base_dir = "data"
    filename = "inventory.csv"
    path = os.path.join(base_dir, filename)

    print("File:", os.path.abspath(path))
    st = os.stat(path)
    print(f"Size: {st.st_size} bytes")
    print("Last modified:", datetime.fromtimestamp(st.st_mtime).isoformat(timespec="seconds"))

    dialect, has_header = sniff_csv_dialect(path)
    delim = getattr(dialect, "delimiter", ",")
    quotechar = getattr(dialect, "quotechar", '"')
    print("\nCSV sniff:")
    print(f"  delimiter: {repr(delim)}")
    print(f"  quotechar: {repr(quotechar)}")
    print(f"  has_header (sniffed): {has_header}")

    df = pd.read_csv(path, sep=delim, quotechar=quotechar, engine="python")

    structured = df.shape[1] > 1 or (df.shape[1] == 1 and df.columns[0] != 0)

    if structured:
        describe_structured(df, filename=filename)
    else:
        describe_unstructured_text(path, filename=filename)


if __name__ == "__main__":
    main()

