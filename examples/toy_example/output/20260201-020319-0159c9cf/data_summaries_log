#!/usr/bin/env python3
"""
Single-file script to load and describe the content of `data/inventory.csv`.

- Handles both structured (CSV-like) and unstructured (text-like) files.
- Prints essential information (columns, dtypes, missingness, shape).
- Prints the content (with safeguards: full output for small files; samples for large files).
- No try/except blocks (per requirement).
"""

from pathlib import Path
import csv
import pandas as pd


def is_mostly_one_column(sample_lines, delimiter=","):
    """Heuristic: if parsing with csv gives 1 column for most lines, it's likely unstructured."""
    reader = csv.reader(sample_lines, delimiter=delimiter)
    row_lengths = [len(row) for row in reader if row]
    if not row_lengths:
        return True
    one_col_ratio = sum(1 for n in row_lengths if n <= 1) / len(row_lengths)
    return one_col_ratio >= 0.8


def sniff_delimiter(sample_text):
    """Try to infer delimiter using csv.Sniffer; fall back to comma."""
    sniffer = csv.Sniffer()
    dialect = sniffer.sniff(sample_text, delimiters=[",", ";", "\t", "|", ":"])
    return dialect.delimiter


def describe_structured(df: pd.DataFrame):
    print("\n=== Structured data detected (tabular) ===")
    print(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")

    print("\nColumn names:")
    print(list(df.columns))

    print("\nDtypes:")
    print(df.dtypes)

    print("\nMissing values per column:")
    print(df.isna().sum())

    print("\nBasic describe (numeric):")
    if df.select_dtypes(include="number").shape[1] > 0:
        print(df.describe(include="number").transpose())
    else:
        print("No numeric columns detected.")

    print("\nBasic describe (non-numeric):")
    non_num = df.select_dtypes(exclude="number")
    if non_num.shape[1] > 0:
        print(non_num.describe(include="all").transpose())
    else:
        print("No non-numeric columns detected.")

    # Print content: full if small, otherwise head/tail/sample
    max_full_rows = 200
    max_full_cols = 50
    pd.set_option("display.max_columns", max_full_cols)
    pd.set_option("display.width", 160)
    pd.set_option("display.max_colwidth", 80)

    print("\n=== Content preview ===")
    if df.shape[0] <= max_full_rows and df.shape[1] <= max_full_cols:
        print("\nFull content (fits within limits):")
        print(df.to_string(index=False))
    else:
        print("\nDataset is large; printing examples only.")
        print("\nHead (first 10 rows):")
        print(df.head(10).to_string(index=False))
        print("\nTail (last 10 rows):")
        print(df.tail(10).to_string(index=False))

        sample_n = min(10, df.shape[0])
        if sample_n > 0:
            print(f"\nRandom sample ({sample_n} rows):")
            print(df.sample(n=sample_n, random_state=42).to_string(index=False))


def describe_unstructured(text: str, path: Path):
    print("\n=== Unstructured data detected (text-like) ===")
    lines = text.splitlines()
    print(f"File: {path}")
    print(f"Characters: {len(text)}")
    print(f"Lines: {len(lines)}")

    non_empty = [ln for ln in lines if ln.strip()]
    print(f"Non-empty lines: {len(non_empty)}")

    # Show first/last lines and some middle samples if large
    print("\n=== Content ===")
    max_lines_full = 200
    if len(lines) <= max_lines_full:
        print(text)
    else:
        head_n = 50
        tail_n = 50
        print(f"(File has many lines; printing first {head_n} and last {tail_n} lines.)\n")
        print("----- BEGIN: FIRST LINES -----")
        print("\n".join(lines[:head_n]))
        print("----- END: FIRST LINES -----\n")
        print("----- BEGIN: LAST LINES -----")
        print("\n".join(lines[-tail_n:]))
        print("----- END: LAST LINES -----")


def main():
    data_dir = Path("data")
    path = data_dir / "inventory.csv"

    raw_bytes = path.read_bytes()
    text = raw_bytes.decode("utf-8", errors="replace")

    # Take a small sample for delimiter sniffing / structure detection
    sample_lines = text.splitlines()[:200]
    sample_text = "\n".join(sample_lines)

    # Decide structured vs unstructured
    delimiter = sniff_delimiter(sample_text)
    tabular_like = not is_mostly_one_column(sample_lines, delimiter=delimiter)

    if tabular_like:
        df = pd.read_csv(path, sep=delimiter, engine="python")
        describe_structured(df)
    else:
        describe_unstructured(text, path)


if __name__ == "__main__":
    main()

