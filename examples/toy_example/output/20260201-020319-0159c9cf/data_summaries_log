#!/usr/bin/env python3
"""
inspect_discounts.py

Loads and describes the content of `discounts.csv` from the `data/` directory.
- Handles both structured CSVs and "unstructured" single-column/text-like CSVs.
- Prints essential information (shape, column names, dtypes, missingness, duplicates).
- Prints the content (full if small; otherwise a representative sample + head/tail).
"""

from pathlib import Path
import sys
import pandas as pd


def is_likely_unstructured(df: pd.DataFrame) -> bool:
    """Heuristic: treat as unstructured if it is basically one text column."""
    if df.shape[1] == 1:
        col = df.columns[0]
        s = df[col].astype(str)
        avg_len = s.str.len().mean() if len(s) else 0
        uniq_ratio = s.nunique(dropna=True) / max(len(s), 1)
        return (avg_len >= 30) or (uniq_ratio >= 0.9)
    return False


def print_df_content(df: pd.DataFrame, max_cells_full_print: int = 20_000) -> None:
    """
    Print the content of the CSV.
    If it's small enough, print entire DataFrame.
    Otherwise, print examples (head/tail + random sample).
    """
    rows, cols = df.shape
    total_cells = rows * cols

    pd.set_option("display.max_columns", None)
    pd.set_option("display.max_colwidth", 200)
    pd.set_option("display.width", 140)

    if total_cells <= max_cells_full_print:
        pd.set_option("display.max_rows", None)
        print("\n=== FULL CONTENT (entire DataFrame) ===")
        print(df.to_string(index=False))
        return

    pd.set_option("display.max_rows", 50)
    head_n = min(20, rows)
    tail_n = min(20, rows)
    sample_n = min(20, rows)

    print("\n=== CONTENT (too large to print entirely) ===")
    print(f"Showing head({head_n}), tail({tail_n}), and a random sample({sample_n}).")

    print(f"\n--- HEAD ({head_n}) ---")
    print(df.head(head_n).to_string(index=False))

    if rows > head_n:
        print(f"\n--- TAIL ({tail_n}) ---")
        print(df.tail(tail_n).to_string(index=False))

    print(f"\n--- RANDOM SAMPLE ({sample_n}) ---")
    print(df.sample(n=sample_n, random_state=42).to_string(index=False))


def resolve_input_path(filename: str = "discounts.csv") -> Path:
    """
    Resolve the input CSV path, assuming all files are in `data/`.
    Tries:
      1) ./data/<filename> (relative to current working directory)
      2) <script_dir>/data/<filename> (relative to this script)
    """
    cwd_candidate = Path("data") / filename
    if cwd_candidate.exists():
        return cwd_candidate

    script_dir = Path(__file__).resolve().parent if "__file__" in globals() else Path.cwd()
    script_candidate = script_dir / "data" / filename
    if script_candidate.exists():
        return script_candidate

    raise FileNotFoundError(
        f"Could not find '{filename}'. Tried:\n"
        f"- {cwd_candidate.resolve()}\n"
        f"- {script_candidate.resolve()}"
    )


def main() -> None:
    try:
        path = resolve_input_path("discounts.csv")
    except FileNotFoundError as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)

    df = pd.read_csv(
        path,
        dtype=str,
        keep_default_na=True,
        na_values=["", "NA", "NaN", "null", "NULL"],
    )

    print("=== FILE ===")
    print(path.resolve())

    print("\n=== BASIC STRUCTURE ===")
    print(f"Rows: {df.shape[0]}")
    print(f"Columns: {df.shape[1]}")

    print("\n=== COLUMN NAMES ===")
    print(list(df.columns))

    print("\n=== PREVIEW (first 5 rows) ===")
    print(df.head(5).to_string(index=False))

    print("\n=== DATA TYPES (currently loaded as strings) ===")
    print(df.dtypes.to_string())

    print("\n=== MISSING VALUES (count per column) ===")
    missing = df.isna().sum().sort_values(ascending=False)
    print(missing.to_string())

    print("\n=== DUPLICATE ROWS ===")
    print(f"Duplicate rows: {df.duplicated().sum()}")

    unstructured = is_likely_unstructured(df)
    print("\n=== FORMAT HEURISTIC ===")
    print("Likely unstructured:" if unstructured else "Likely structured:", unstructured)

    if not unstructured:
        print("\n=== BASIC DESCRIPTIVE STATS (by column; treating everything as text) ===")
        desc = df.describe(include="all").transpose()
        if desc.shape[0] > 40:
            print("Too many columns to print full describe(); showing first 20 and last 20.")
            print("\n--- DESCRIBE (first 20 columns) ---")
            print(desc.head(20).to_string())
            print("\n--- DESCRIBE (last 20 columns) ---")
            print(desc.tail(20).to_string())
        else:
            print(desc.to_string())

        print("\n=== UNIQUE VALUE COUNTS (top 10 columns by cardinality) ===")
        nunique = df.nunique(dropna=True).sort_values(ascending=False)
        print(nunique.head(10).to_string())

        print("\n=== TOP VALUES PER COLUMN (up to 5 most frequent; limited columns) ===")
        cols_to_show = list(nunique.head(8).index)
        for c in cols_to_show:
            print(f"\n--- Column: {c} ---")
            vc = df[c].value_counts(dropna=False).head(5)
            print(vc.to_string())
    else:
        col = df.columns[0]
        s = df[col].astype(str)
        lengths = s.str.len()
        print("\n=== UNSTRUCTURED TEXT SUMMARY ===")
        print(f"Text column: {col}")
        print("\n--- LENGTH STATS ---")
        print(lengths.describe().to_string())
        print("\n--- EXAMPLES (first 10 non-empty lines) ---")
        non_empty = df[df[col].notna() & (df[col].astype(str).str.strip() != "")]
        print(non_empty.head(10).to_string(index=False))

    print_df_content(df)


if __name__ == "__main__":
    main()
