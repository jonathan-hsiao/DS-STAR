import json
from pathlib import Path

fees_path = Path("/Users/jonathan/github/DS-STAR/examples/dabstep/data/fees.json")

with fees_path.open("r", encoding="utf-8") as f:
    fees = json.load(f)

print(f"Loaded fees.json rows: {len(fees)}")

filtered = [
    row for row in fees
    if row.get("card_scheme") == "GlobalCard" and row.get("is_credit") is True
]

print(f"Filtered rows (card_scheme='GlobalCard' AND is_credit==True): {len(filtered)}")

# Print a small preview of filtered rules (important for downstream fee computation)
print("Preview of first 5 filtered rows:")
for r in filtered[:5]:
    print({
        "ID": r.get("ID"),
        "card_scheme": r.get("card_scheme"),
        "is_credit": r.get("is_credit"),
        "rate": r.get("rate"),
        "fixed_amount": r.get("fixed_amount"),
        "intracountry": r.get("intracountry"),
        "capture_delay": r.get("capture_delay"),
        "monthly_volume": r.get("monthly_volume"),
        "monthly_fraud_level": r.get("monthly_fraud_level"),
        "merchant_category_code_len": len(r.get("merchant_category_code") or []),
        "aci": r.get("aci"),
        "account_type": r.get("account_type"),
    })

# Step #2: Compute per-transaction fee for 10 EUR and average across all filtered rules
amount_eur = 10.0
per_tx_fees = []
bad_rows = 0

for r in filtered:
    fixed_amount = r.get("fixed_amount")
    rate = r.get("rate")

    # Defensive checks: both should be present and numeric
    if fixed_amount is None or rate is None:
        bad_rows += 1
        continue

    try:
        fee = float(fixed_amount) + (float(rate) / 10000.0) * amount_eur
    except (TypeError, ValueError):
        bad_rows += 1
        continue

    per_tx_fees.append(fee)

print(f"Computed per-transaction fees for 10 EUR: {len(per_tx_fees)} rows (skipped {bad_rows} rows)")

if per_tx_fees:
    mean_fee = sum(per_tx_fees) / len(per_tx_fees)
    print(f"Mean fee across filtered GlobalCard credit rules for {amount_eur:.2f} EUR: {mean_fee:.6f} EUR")

    # Helpful sanity-check: show a small preview of computed fees
    print("Preview of first 10 computed fees (EUR):")
    for x in per_tx_fees[:10]:
        print(f"{x:.6f}")
else:
    print("No fees computed (empty per_tx_fees); cannot compute mean.")

