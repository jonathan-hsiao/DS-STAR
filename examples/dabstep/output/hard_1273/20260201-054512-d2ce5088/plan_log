import json
import pandas as pd

# Step #1: Load `fees.json` into a dataframe and filter to rows where
# `card_scheme == "GlobalCard"` and `is_credit == true` to identify the applicable fee records for credit transactions.

fees_path = "data/fees.json"

with open(fees_path, "r", encoding="utf-8") as f:
    fees = json.load(f)

fees_df = pd.DataFrame(fees)

print("fees_df shape:", fees_df.shape)
print("fees_df columns:", list(fees_df.columns))

# Filter to GlobalCard + credit
filtered_fees = fees_df[(fees_df["card_scheme"] == "GlobalCard") & (fees_df["is_credit"] == True)].copy()

print("\nFiltered (GlobalCard & is_credit==True) shape:", filtered_fees.shape)
print("\nFiltered sample (first 10 rows):")
print(filtered_fees.head(10).to_string(index=False))

# Useful quick summary for inspection
print("\nFiltered fee rates summary (rate):")
print(filtered_fees["rate"].describe().to_string())

print("\nFiltered fixed_amount summary (fixed_amount):")
print(filtered_fees["fixed_amount"].describe().to_string())

print("\nNull counts in key rule columns:")
print(
    filtered_fees[
        [
            "account_type",
            "aci",
            "capture_delay",
            "merchant_category_code",
            "monthly_fraud_level",
            "monthly_volume",
            "intracountry",
        ]
    ]
    .isna()
    .sum()
    .to_string()
)

# Step #2: Compute the average GlobalCard credit fee for a 10 EUR transaction
# fee_eur = fixed_amount + (rate/10000)*10, then take mean.

txn_amount_eur = 10.0

# Ensure numeric types for computation
filtered_fees["fixed_amount"] = pd.to_numeric(filtered_fees["fixed_amount"], errors="coerce")
filtered_fees["rate"] = pd.to_numeric(filtered_fees["rate"], errors="coerce")

# Compute fee in EUR for a 10 EUR transaction
filtered_fees["fee_eur"] = filtered_fees["fixed_amount"] + (filtered_fees["rate"] / 10000.0) * txn_amount_eur

print("\nComputed fee_eur for txn_amount_eur =", txn_amount_eur)
print("fee_eur null count:", int(filtered_fees["fee_eur"].isna().sum()))
print("\nfee_eur summary:")
print(filtered_fees["fee_eur"].describe().to_string())

avg_fee_eur = filtered_fees["fee_eur"].mean()
print("\nAverage GlobalCard credit fee for a 10 EUR transaction (fee_eur.mean()):", avg_fee_eur)

