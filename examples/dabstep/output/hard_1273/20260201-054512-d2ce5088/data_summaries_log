#!/usr/bin/env python3
"""
Single-file program to load and describe `payments.csv`.

- Handles both structured CSVs and "unstructured" text-like CSVs.
- Prints essential information (columns, shape, dtypes, missingness, samples).
- Prints the content of `payments.csv` (full for small files, sampled/head/tail for large).
- No try/except blocks (per requirement).

Note: All files are expected to be in the `data/` directory.
"""

import os
import csv
import pandas as pd


def resolve_path(filename: str, data_dir: str = "data") -> str:
    # Prefer data/filename; fall back to filename if caller already provided a path that exists.
    candidate = os.path.join(data_dir, filename)
    if os.path.exists(candidate):
        return candidate
    return filename


def detect_dialect_and_delimiter(path: str, sample_bytes: int = 65536):
    with open(path, "r", newline="", encoding="utf-8") as f:
        sample = f.read(sample_bytes)
    sniffer = csv.Sniffer()
    dialect = sniffer.sniff(sample)
    has_header = sniffer.has_header(sample)
    return dialect, has_header


def read_csv_robust(path: str, delimiter: str | None = None):
    # Read as strings first to avoid type inference surprises; we'll compute summaries ourselves.
    read_kwargs = dict(
        dtype=str,
        keep_default_na=True,
        na_values=["", "NA", "N/A", "null", "NULL"],
    )
    if delimiter is None:
        return pd.read_csv(path, **read_kwargs)
    return pd.read_csv(path, sep=delimiter, **read_kwargs)


def print_structured_summary(df: pd.DataFrame):
    print("\n=== Structured summary ===")
    print(f"Shape (rows, cols): {df.shape[0]}, {df.shape[1]}")
    print("\nColumn names:")
    for i, c in enumerate(df.columns, start=1):
        print(f"{i:>3}. {c}")

    print("\nColumn overview (non-null, nulls, unique, top values):")
    rows = []
    for c in df.columns:
        s = df[c]
        non_null = int(s.notna().sum())
        nulls = int(s.isna().sum())
        nunique = int(s.nunique(dropna=True))

        vc = s.dropna().astype(str).value_counts()
        top = vc.head(3)
        top_str = "; ".join([f"{idx} ({cnt})" for idx, cnt in top.items()]) if len(top) else ""
        rows.append((c, non_null, nulls, nunique, top_str))

    col_w = max(10, min(40, max(len(r[0]) for r in rows) if rows else 10))
    print(f"{'Column':<{col_w}}  {'Non-null':>8}  {'Nulls':>6}  {'Unique':>7}  Top values")
    print("-" * (col_w + 2 + 8 + 2 + 6 + 2 + 7 + 2 + 10))
    for c, non_null, nulls, nunique, top_str in rows:
        print(f"{c:<{col_w}}  {non_null:>8}  {nulls:>6}  {nunique:>7}  {top_str}")

    print("\nNumeric-like columns (based on coercion) quick stats:")
    any_numeric = False
    for c in df.columns:
        s = df[c]
        num = pd.to_numeric(s, errors="coerce")
        non_null = s.notna().sum()
        if non_null == 0:
            continue
        converted = num.notna().sum()
        if converted / non_null >= 0.60:
            any_numeric = True
            desc = num.describe(percentiles=[0.25, 0.5, 0.75])
            print(f"\n- {c}")
            print(desc.to_string())
    if not any_numeric:
        print("(No numeric-like columns detected by heuristic.)")


def print_content(df: pd.DataFrame, max_full_rows: int = 200, max_cols: int = 80):
    print("\n=== Content of payments.csv ===")
    pd.set_option("display.max_columns", max_cols)
    pd.set_option("display.width", 0)
    pd.set_option("display.max_colwidth", 200)

    nrows, ncols = df.shape
    if nrows <= max_full_rows:
        print(df.to_string(index=False))
    else:
        print(f"(File has {nrows} rows; printing head(20), tail(20), and a random sample(20).)")
        print("\n--- HEAD (20) ---")
        print(df.head(20).to_string(index=False))
        print("\n--- TAIL (20) ---")
        print(df.tail(20).to_string(index=False))
        print("\n--- RANDOM SAMPLE (20) ---")
        print(df.sample(n=min(20, nrows), random_state=42).to_string(index=False))


def print_unstructured_view(path: str, max_lines: int = 120, max_chars_per_line: int = 500):
    print("\n=== Unstructured view (raw text preview) ===")
    print(f"Showing up to {max_lines} lines from payments.csv (truncated per line to {max_chars_per_line} chars).")
    with open(path, "r", encoding="utf-8") as f:
        for i, line in enumerate(f, start=1):
            if i > max_lines:
                break
            line = line.rstrip("\n")
            if len(line) > max_chars_per_line:
                line = line[:max_chars_per_line] + "…"
            print(f"{i:>5}: {line}")


def decide_structured_or_unstructured(df: pd.DataFrame) -> str:
    nrows, ncols = df.shape
    if ncols == 1:
        s = df.iloc[:, 0].dropna().astype(str)
        if len(s) == 0:
            return "unstructured"
        lengths = s.str.len()
        long_frac = (lengths > 120).mean()
        if long_frac >= 0.25 or s.nunique() / max(1, len(s)) > 0.9:
            return "unstructured"
    return "structured"


def main():
    filename = "payments.csv"
    path = resolve_path(filename, data_dir="data")

    print("=== payments.csv loader & describer ===")
    print(f"Path: {os.path.abspath(path)}")
    print(f"File size (bytes): {os.path.getsize(path)}")

    dialect, has_header = detect_dialect_and_delimiter(path)
    delim = getattr(dialect, "delimiter", ",")
    quotechar = getattr(dialect, "quotechar", '"')
    print("\n=== CSV sniffing ===")
    print(f"Detected delimiter: {repr(delim)}")
    print(f"Detected quotechar: {repr(quotechar)}")
    print(f"Sniffer thinks file has header: {has_header}")

    df = read_csv_robust(path, delimiter=delim)
    mode = decide_structured_or_unstructured(df)
    print(f"\nMode decision: {mode}")

    if mode == "structured":
        print_structured_summary(df)
        print_content(df)
    else:
        print("\n(Parsed as 1-column/likely unstructured content; showing raw preview and basic counts.)")
        print(f"Parsed shape: {df.shape[0]} rows, {df.shape[1]} cols")
        if df.shape[1] > 0:
            col = df.columns[0]
            s = df[col].dropna().astype(str)
            print(f"Column name: {col}")
            print(f"Non-null rows: {len(s)}")
            if len(s) > 0:
                lengths = s.str.len()
                print("\nLine length stats:")
                print(lengths.describe().to_string())
                starts = s.str.slice(0, 40).value_counts().head(10)
                print("\nMost common line starts (first 40 chars):")
                for k, v in starts.items():
                    print(f"{repr(k)}: {v}")
        print_unstructured_view(path)

        print("\n=== Parsed content preview (as read by pandas) ===")
        print_content(df, max_full_rows=200, max_cols=20)


if __name__ == "__main__":
    main()

