#!/usr/bin/env python3
"""
Inspect and describe the content of merchant_data.json.

- Supports structured JSON (list/dict) and unstructured JSON (strings, mixed).
- Prints essential information (top-level type, keys, column names if tabular).
- Prints the content (pretty-printed), truncating large outputs with examples.
- No try/except blocks.
- Assumes all files/documents are in `data/` directory.

Fix:
- Resolve `data/merchant_data.json` relative to the current working directory
  (where you run the script), not relative to the script's temporary location.
"""

import json
import os
from collections import Counter
from datetime import datetime

DATA_DIR = "data"
JSON_FILENAME = "merchant_data.json"
JSON_PATH = os.path.join(DATA_DIR, JSON_FILENAME)

MAX_PREVIEW_CHARS = 120_000   # cap for printing raw/prettified JSON to avoid huge terminals
MAX_ITEMS_SHOW = 5            # examples for large lists
MAX_KEYS_SHOW = 50            # show up to N keys in dict
MAX_COLUMNS_SHOW = 200        # show up to N "columns" for tabular data
MAX_UNIQUE_VALUES_SHOW = 10   # per-column sample unique values


def is_scalar(x):
    return x is None or isinstance(x, (str, int, float, bool))


def short_repr(x, max_len=200):
    s = repr(x)
    if len(s) > max_len:
        return s[: max_len - 3] + "..."
    return s


def safe_json_dumps(obj, indent=2):
    return json.dumps(obj, ensure_ascii=False, indent=indent)


def infer_tabular(records):
    """
    Determine if 'records' looks like tabular data:
    - a list of dicts (possibly with some non-dicts mixed in)
    Returns (is_tabular, list_of_dicts_only)
    """
    if not isinstance(records, list):
        return False, []
    dicts = [r for r in records if isinstance(r, dict)]
    return (len(dicts) > 0 and len(dicts) >= max(1, int(0.7 * len(records)))), dicts


def collect_columns(dicts):
    cols = set()
    for d in dicts:
        cols.update(d.keys())
    return sorted(cols)


def basic_type_summary(values):
    c = Counter(type(v).__name__ for v in values)
    return dict(c)


def sample_values(values, limit=MAX_UNIQUE_VALUES_SHOW):
    uniq = []
    seen = set()
    for v in values:
        key = (type(v).__name__, short_repr(v, 120))
        if key in seen:
            continue
        seen.add(key)
        uniq.append(v)
        if len(uniq) >= limit:
            break
    return uniq


def describe_tabular(dicts):
    print("\n=== TABULAR SUMMARY (list of objects) ===")
    n = len(dicts)
    print(f"Number of object records: {n}")

    columns = collect_columns(dicts)
    print(f"Number of columns (union of keys): {len(columns)}")
    if len(columns) <= MAX_COLUMNS_SHOW:
        print("Columns:")
        for col in columns:
            print(f" - {col}")
    else:
        print("Columns (showing first few):")
        for col in columns[:MAX_COLUMNS_SHOW]:
            print(f" - {col}")
        print(f"... ({len(columns) - MAX_COLUMNS_SHOW} more columns)")

    print("\nColumn-level essentials (presence, types, sample values):")
    for col in columns[: min(len(columns), 50)]:
        col_vals = [d.get(col, None) for d in dicts]
        present = sum(1 for v in col_vals if v is not None)
        missing = n - present
        types = basic_type_summary([v for v in col_vals if v is not None])
        samples = sample_values([v for v in col_vals if v is not None], limit=5)

        print(f"\n[{col}]")
        print(f"  present: {present}/{n}  missing: {missing}/{n}")
        print(f"  types: {types if types else {'NoneType': n}}")
        if samples:
            print("  sample values:")
            for sv in samples:
                if is_scalar(sv):
                    print(f"   - {sv!r}")
                else:
                    print(f"   - {short_repr(sv, 300)}")
        else:
            print("  sample values: (none)")

    print("\nExample records:")
    for i, row in enumerate(dicts[:MAX_ITEMS_SHOW]):
        print(f"\n--- record[{i}] ---")
        print(safe_json_dumps(row, indent=2))


def print_content_preview(obj):
    print("\n=== CONTENT PREVIEW ===")
    dumped = safe_json_dumps(obj, indent=2)
    if len(dumped) <= MAX_PREVIEW_CHARS:
        print(dumped)
    else:
        print(dumped[:MAX_PREVIEW_CHARS])
        print(f"\n... [truncated JSON output at {MAX_PREVIEW_CHARS} chars; total chars: {len(dumped)}]")


def describe_json(obj, json_path):
    print("=== FILE INFO ===")
    print(f"path: {os.path.abspath(json_path)}")
    print(f"loaded_at: {datetime.utcnow().isoformat()}Z")

    print("\n=== TOP-LEVEL SUMMARY ===")
    print(f"type: {type(obj).__name__}")

    if isinstance(obj, dict):
        keys = list(obj.keys())
        print(f"num_keys: {len(keys)}")
        if len(keys) <= MAX_KEYS_SHOW:
            print("keys:")
            for k in keys:
                print(f" - {k}")
        else:
            print("keys (showing first few):")
            for k in keys[:MAX_KEYS_SHOW]:
                print(f" - {k}")
            print(f"... ({len(keys) - MAX_KEYS_SHOW} more keys)")

        list_candidates = []
        for k, v in obj.items():
            if isinstance(v, list) and len(v) > 0:
                is_tab, dicts = infer_tabular(v)
                if is_tab:
                    list_candidates.append((k, len(dicts), dicts))
        if list_candidates:
            list_candidates.sort(key=lambda x: x[1], reverse=True)
            k, m, dicts = list_candidates[0]
            print(f"\nDetected tabular-like list under key: {k!r} (object records: {m})")
            describe_tabular(dicts)

    elif isinstance(obj, list):
        print(f"num_items: {len(obj)}")
        types = Counter(type(x).__name__ for x in obj)
        print(f"item_types: {dict(types)}")

        is_tab, dicts = infer_tabular(obj)
        if is_tab:
            describe_tabular(dicts)
        else:
            print("\nExample items:")
            for i, item in enumerate(obj[:MAX_ITEMS_SHOW]):
                print(f"\n--- item[{i}] (type={type(item).__name__}) ---")
                if is_scalar(item):
                    print(item)
                else:
                    print(safe_json_dumps(item, indent=2))

    else:
        print("Top-level JSON is unstructured/scalar.")
        print(f"value: {short_repr(obj, 2000)}")

    print_content_preview(obj)


def resolve_json_path():
    # Prefer resolving relative to the current working directory
    # (so `data/merchant_data.json` works when running from the project root).
    cwd_path = os.path.join(os.getcwd(), JSON_PATH)
    if os.path.exists(cwd_path):
        return cwd_path

    # Fallback to script directory for cases where the script is placed in the project root.
    script_dir = os.path.dirname(os.path.abspath(__file__))
    script_path = os.path.join(script_dir, JSON_PATH)
    if os.path.exists(script_path):
        return script_path

    # Final fallback: return the cwd-based path (will raise FileNotFoundError on open).
    return cwd_path


def main():
    json_path = resolve_json_path()
