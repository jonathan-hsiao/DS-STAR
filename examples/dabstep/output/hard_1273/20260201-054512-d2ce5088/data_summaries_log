#!/usr/bin/env python3
"""
Describe and print the content of `merchant_category_codes.csv` (located in `data/`).

- Handles both structured CSVs (tabular) and "unstructured" CSVs (e.g., single text column, irregular rows).
- Prints essential information: columns, shape, dtypes, missingness, basic stats, and samples.
- Prints the content: full content if reasonably small; otherwise prints a preview plus a deterministic sample.
- No try/except by request.
"""

from pathlib import Path
import csv
import pandas as pd

DATA_DIR = Path("data")
FILE_NAME = "merchant_category_codes.csv"
FILE_PATH = DATA_DIR / FILE_NAME

# Print controls
MAX_FULL_PRINT_ROWS = 300        # If structured and <= this many rows, print all rows
MAX_FULL_PRINT_CHARS = 250_000   # If unstructured or raw text and <= this many chars, print all raw text
HEAD_ROWS = 20
TAIL_ROWS = 20
SAMPLE_ROWS = 10
SAMPLE_RANDOM_STATE = 42


def read_raw_text(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def sniff_csv_dialect(sample: str):
    sniffer = csv.Sniffer()
    return sniffer.sniff(sample)


def is_likely_structured(df: pd.DataFrame) -> bool:
    if df is None or df.empty:
        return False
    if df.shape[1] >= 2:
        return True
    if df.shape[1] == 1 and df.shape[0] >= 2:
        return True
    return False


def print_structured_summary(df: pd.DataFrame):
    print("=== Structured Data Summary (pandas) ===")
    print(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")

    print("\nColumn names:")
    for i, c in enumerate(df.columns, start=1):
        print(f"  {i:>2}. {c}")

    print("\nDtypes:")
    dtypes = df.dtypes.astype(str)
    for col in df.columns:
        print(f"  {col}: {dtypes[col]}")

    print("\nMissing values per column:")
    na_counts = df.isna().sum()
    for col in df.columns:
        print(f"  {col}: {int(na_counts[col])}")

    numeric_cols = df.select_dtypes(include="number").columns.tolist()
    if numeric_cols:
        print("\nNumeric columns summary (describe):")
        print(df[numeric_cols].describe().to_string())

    if df.shape[0] > 0:
        dup_rows = int(df.duplicated().sum())
        print(f"\nDuplicate rows: {dup_rows}")

    print("\n=== CSV Content ===")
    if df.shape[0] <= MAX_FULL_PRINT_ROWS:
        print(df.to_string(index=False))
    else:
        print(f"(Too many rows to print fully: {df.shape[0]} rows. Showing head/tail and a sample.)\n")
        print("--- HEAD ---")
        print(df.head(HEAD_ROWS).to_string(index=False))
        print("\n--- TAIL ---")
        print(df.tail(TAIL_ROWS).to_string(index=False))
        print("\n--- SAMPLE ---")
        sample_n = min(SAMPLE_ROWS, df.shape[0])
        print(df.sample(n=sample_n, random_state=SAMPLE_RANDOM_STATE).to_string(index=False))


def print_unstructured_summary(raw: str, path: Path):
    print("=== Unstructured / Raw Content ===")
    print(f"File: {path.resolve()}")
    print(f"Total characters: {len(raw)}")
    line_count = raw.count("\n") + (1 if raw else 0)
    print(f"Total lines: {line_count}")

    print("\n--- First 50 lines (or fewer) ---")
    lines = raw.splitlines()
    for i, line in enumerate(lines[:50], start=1):
        print(f"{i:>4}: {line}")

    print("\n=== Full Content ===")
    if len(raw) <= MAX_FULL_PRINT_CHARS:
        print(raw)
    else:
        print(f"(Raw content too large to print fully: {len(raw)} chars. Showing start and end.)\n")
        start = raw[:10000]
        end = raw[-10000:]
        print("--- START (first 10,000 chars) ---")
        print(start)
        print("\n--- END (last 10,000 chars) ---")
        print(end)


def main():
    path = FILE_PATH
    raw = read_raw_text(path)

    print("=== File Preview ===")
    preview = raw[:5000]
    print(preview)
    if len(raw) > len(preview):
        print(f"\n(Preview truncated: showing first {len(preview)} chars of {len(raw)} total.)\n")

    dialect = sniff_csv_dialect(preview)
    sep = dialect.delimiter

    df = pd.read_csv(
        path,
        sep=sep,
        engine="python",
        on_bad_lines="warn",
    )

    if is_likely_structured(df):
        print_structured_summary(df)
    else:
        print_unstructured_summary(raw, path)


if __name__ == "__main__":
    main()

