#!/usr/bin/env python3
import json
import os
import sys
from collections import Counter
from datetime import datetime

DATA_DIR = "data"
FILENAME = "fees.json"
PATH = os.path.join(DATA_DIR, FILENAME)

MAX_STR_PREVIEW = 2000
MAX_ITEMS_PREVIEW = 5
MAX_KEYS_PREVIEW = 50
MAX_LIST_ELEMS_INLINE = 20


def is_scalar(x):
    return x is None or isinstance(x, (bool, int, float, str))


def type_name(x):
    if x is None:
        return "null"
    if isinstance(x, bool):
        return "bool"
    if isinstance(x, int) and not isinstance(x, bool):
        return "int"
    if isinstance(x, float):
        return "float"
    if isinstance(x, str):
        return "str"
    if isinstance(x, list):
        return "list"
    if isinstance(x, dict):
        return "dict"
    return type(x).__name__


def safe_repr(x, maxlen=MAX_STR_PREVIEW):
    r = repr(x)
    if len(r) > maxlen:
        return r[:maxlen] + " ... (truncated)"
    return r


def print_header(title):
    print("\n" + "=" * 80)
    print(title)
    print("=" * 80)


def flatten_paths(obj, prefix=""):
    """
    Return a set of dotted paths to leaf/scalar values in nested dicts/lists.
    For lists, uses '[]' to represent any element.
    """
    paths = set()
    if is_scalar(obj):
        paths.add(prefix or "<root>")
        return paths
    if isinstance(obj, dict):
        if not obj:
            paths.add(prefix or "<root>")  # empty dict
            return paths
        for k, v in obj.items():
            key = str(k)
            new_prefix = f"{prefix}.{key}" if prefix else key
            paths |= flatten_paths(v, new_prefix)
        return paths
    if isinstance(obj, list):
        if not obj:
            paths.add((prefix + "[]") if prefix else "[]")  # empty list
            return paths
        list_prefix = (prefix + "[]") if prefix else "[]"
        for v in obj[:MAX_ITEMS_PREVIEW]:
            paths |= flatten_paths(v, list_prefix)
        return paths
    paths.add(prefix or "<root>")
    return paths


def describe_dict(d, title="Object"):
    print_header(f"{title} (dict)")
    print(f"Number of keys: {len(d)}")
    keys = list(d.keys())
    print(f"Keys (up to {MAX_KEYS_PREVIEW}): {keys[:MAX_KEYS_PREVIEW]}")
    types = {k: type_name(v) for k, v in d.items()}
    type_counts = Counter(types.values())
    print("Value type distribution:")
    for t, c in type_counts.most_common():
        print(f"  - {t}: {c}")
    print("\nExample fields (up to 10):")
    for k in keys[:10]:
        v = d[k]
        if is_scalar(v):
            print(f"  {k}: {safe_repr(v, 300)}")
        else:
            print(f"  {k}: <{type_name(v)}>")


def describe_list(lst, title="Array"):
    print_header(f"{title} (list)")
    print(f"Number of items: {len(lst)}")
    elem_types = Counter(type_name(x) for x in lst[: min(len(lst), 1000)])
    print("Element type distribution (from up to first 1000 items):")
    for t, c in elem_types.most_common():
        print(f"  - {t}: {c}")

    dict_items = [x for x in lst if isinstance(x, dict)]
    if dict_items:
        union_keys = set()
        for x in dict_items[: min(len(dict_items), 1000)]:
            union_keys |= set(map(str, x.keys()))
        union_keys = sorted(union_keys)
        print(f"\nDetected list of dicts. Column names (union) count: {len(union_keys)}")
        print(f"Column names (up to {MAX_KEYS_PREVIEW}): {union_keys[:MAX_KEYS_PREVIEW]}")

        sample_n = min(len(dict_items), 200)
        present_counts = Counter()
        for x in dict_items[:sample_n]:
            present_counts.update(map(str, x.keys()))
        print(f"\nKey presence in first {sample_n} dict items (top 20):")
        for k, c in present_counts.most_common(20):
            print(f"  - {k}: {c}/{sample_n}")

        print(f"\nExample items (up to {MAX_ITEMS_PREVIEW}):")
        for i, x in enumerate(lst[:MAX_ITEMS_PREVIEW]):
            print(f"\nItem {i}:")
            print(safe_repr(x, MAX_STR_PREVIEW))
    else:
        print(f"\nExample elements (up to {MAX_ITEMS_PREVIEW}):")
        for i, x in enumerate(lst[:MAX_ITEMS_PREVIEW]):
            print(f"  [{i}] {safe_repr(x, 500)}")


def describe_root(data):
    print_header("fees.json: High-level description")
    print(f"Python type: {type_name(data)}")
    if isinstance(data, (dict, list)):
        if isinstance(data, dict):
            print(f"Top-level keys: {len(data)}")
        else:
            print(f"Top-level items: {len(data)}")

    paths = sorted(flatten_paths(data))
    print(f"\nDiscovered leaf-field paths (up to {MAX_KEYS_PREVIEW}):")
    print(paths[:MAX_KEYS_PREVIEW])
    if len(paths) > MAX_KEYS_PREVIEW:
        print(f"... ({len(paths) - MAX_KEYS_PREVIEW} more paths not shown)")


def print_content(data):
    print_header("fees.json: Full content preview")
    if isinstance(data, (dict, list)):
        text = json.dumps(data, ensure_ascii=False, indent=2)
        print(text)
    else:
        print(data)


def file_not_found_hint(path):
    data_dir = os.path.dirname(path) or "."
    try:
        entries = sorted(os.listdir(data_dir))
    except Exception:
        entries = None

    msg = [
        f"File not found: {path}",
        f"Working directory: {os.getcwd()}",
    ]
    if entries is not None:
        preview = entries[:200]
        msg.append(f"Contents of '{data_dir}' (up to 200 entries): {preview}")
        if len(entries) > 200:
            msg.append(f"... ({len(entries) - 200} more not shown)")
    return "\n".join(msg)


def main():
    print_header("Runtime / File info")
    print(f"Working directory: {os.getcwd()}")
    print(f"Target file: {PATH}")

    if not os.path.isfile(PATH):
        print(file_not_found_hint(PATH), file=sys.stderr)
        sys.exit(2)

    st = os.stat(PATH)
    print(f"File size (bytes): {st.st_size}")
    print(f"Last modified: {datetime.fromtimestamp(st.st_mtime).isoformat()}")

    with open(PATH, "r", encoding="utf-8") as f:
        data = json.load(f)

    describe_root(data)

    if isinstance(data, dict):
        describe_dict(data, "Top-level object")
        list_candidates = [(k, v) for k, v in data.items() if isinstance(v, list)]
        if list_candidates:
            k, v = max(list_candidates, key=lambda kv: len(kv[1]))
            describe_list(v, f"Nested array at key '{k}'")
    elif isinstance(data, list):
        describe_list(data, "Top-level array")

    print_content(data)


if __name__ == "__main__":
    main()

