#!/usr/bin/env python3
import os
import sys
import csv
import pandas as pd

DATA_DIR = "data"


def resolve_file_path(arg_path: str | None, data_dir: str = DATA_DIR) -> str:
    """
    Resolve input path with these rules:
    - If arg_path is None: error with usage.
    - If arg_path is an existing path as-is: use it.
    - Else if it's a basename or relative path that exists under data_dir: use data_dir/arg_path.
    - Else error with a clear message listing tried paths.
    """
    if not arg_path:
        raise FileNotFoundError(
            f"No input file provided.\n"
            f"Usage: {os.path.basename(sys.argv[0])} <filename-or-path>\n"
            f"Note: files are expected under ./{data_dir}/"
        )

    candidates = []
    # As provided
    candidates.append(arg_path)
    # Under data/
    candidates.append(os.path.join(data_dir, arg_path))

    for p in candidates:
        if os.path.isfile(p):
            return p

    raise FileNotFoundError(
        "File not found. Tried:\n- " + "\n- ".join(os.path.abspath(p) for p in candidates)
    )


def detect_delimiter(file_path, sample_bytes=65536):
    with open(file_path, "r", encoding="utf-8", errors="replace", newline="") as f:
        sample = f.read(sample_bytes)
    try:
        return csv.Sniffer().sniff(sample).delimiter
    except csv.Error:
        return ","


def human_bytes(n):
    units = ["B", "KB", "MB", "GB", "TB"]
    x = float(n)
    for u in units:
        if x < 1024 or u == units[-1]:
            return f"{x:.2f} {u}"
        x /= 1024


def print_file_head(file_path, n_lines=30):
    print(f"\n=== Raw file head (first {n_lines} lines) ===")
    with open(file_path, "r", encoding="utf-8", errors="replace") as f:
        for i, line in enumerate(f):
            if i >= n_lines:
                break
            print(f"{i+1:>4}: {line.rstrip()}")


def print_file_tail(file_path, n_lines=10):
    print(f"\n=== Raw file tail (last {n_lines} lines) ===")
    with open(file_path, "r", encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    start = max(1, len(lines) - n_lines + 1)
    for i, line in enumerate(lines[-n_lines:], start=start):
        print(f"{i:>4}: {line.rstrip()}")


def load_as_dataframe(file_path, delimiter):
    df = pd.read_csv(
        file_path,
        sep=delimiter,
        engine="python",
        dtype=None,
        keep_default_na=True,
    )
    return df


def describe_dataframe(df, max_examples=10, max_unique_to_list=20):
    print("\n=== Structured parse (pandas DataFrame) ===")
    print(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")

    print("\nColumn names:")
    print(list(df.columns))

    print("\nDtypes:")
    print(df.dtypes)

    print("\nMissing values per column (count, percent):")
    miss = df.isna().sum()
    miss_pct = (miss / len(df) * 100) if len(df) else miss
    miss_tbl = (
        pd.DataFrame({"missing_count": miss, "missing_pct": miss_pct})
        .sort_values("missing_count", ascending=False)
    )
    print(miss_tbl)

    print("\nHead (first rows):")
    print(df.head(max_examples).to_string(index=False))

    if len(df) > max_examples:
        print(f"\nSample ({max_examples} random rows):")
        print(df.sample(n=max_examples, random_state=42).to_string(index=False))

    num_cols = df.select_dtypes(include="number").columns.tolist()
    if num_cols:
        print("\nNumeric columns summary (describe):")
        print(df[num_cols].describe().to_string())

    obj_cols = df.columns[df.dtypes == "object"].tolist()
    if obj_cols:
        print("\nText/Categorical columns (cardinality + example unique values):")
        for c in obj_cols:
            nunique = df[c].nunique(dropna=True)
            print(f"\n- {c}: non-null={df[c].notna().sum()}  unique(non-null)={nunique}")
            if nunique <= max_unique_to_list:
                vals = df[c].dropna().unique().tolist()
                print("  unique values:", vals)
            else:
                vals = df[c].dropna().astype(str).unique()[:max_unique_to_list].tolist()
                print(f"  first {max_unique_to_list} unique values:", vals)


def main():
    # Default to a commonly used filename if none provided, but still resolve under data/
    arg = sys.argv[1] if len(sys.argv) > 1 else "acquirer_countries.csv"
    file_path = resolve_file_path(arg, DATA_DIR)

    print("=== File info ===")
    print("Path:", os.path.abspath(file_path))
    st = os.stat(file_path)
    print("Size:", human_bytes(st.st_size))

    delimiter = detect_delimiter(file_path)
    print("Detected delimiter:", repr(delimiter))

    print_file_head(file_path, n_lines=40)
    print_file_tail(file_path, n_lines=10)

    df = load_as_dataframe(file_path, delimiter)
    describe_dataframe(df, max_examples=10, max_unique_to_list=20)

    print("\n=== Full content output ===")
    if df.shape[0] <= 200 and df.shape[1] <= 50:
        print(df.to_string(index=False))
    else:
        print(
            f"Dataset is large ({df.shape[0]} rows x {df.shape[1]} cols). "
            "Printing first 200 rows instead:"
        )
        print(df.head(200).to_string(index=False))


if __name__ == "__main__":
    main()
