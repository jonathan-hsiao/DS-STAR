import pandas as pd

# Step 1: Load payments.csv
payments_path = "data/payments.csv"
df = pd.read_csv(payments_path)

print("Loaded payments.csv")
print("Shape:", df.shape)
print("Columns:", list(df.columns))

# Ensure has_fraudulent_dispute is boolean (in case it's read as string)
if df["has_fraudulent_dispute"].dtype == "object":
    df["has_fraudulent_dispute"] = df["has_fraudulent_dispute"].map(
        {"True": True, "False": False, True: True, False: False}
    )

# Compute fraud rate by ip_country
fraud_by_ip_country = (
    df.groupby("ip_country", dropna=False)["has_fraudulent_dispute"]
      .mean()
      .sort_values(ascending=False)
)

print("\nFraud rate by ip_country (mean of has_fraudulent_dispute), sorted desc:")
print(fraud_by_ip_country.to_string())

# Compare NL, BE, ES, FR specifically
countries_to_compare = ["NL", "BE", "ES", "FR"]

comparison = (
    df[df["ip_country"].isin(countries_to_compare)]
      .groupby("ip_country")["has_fraudulent_dispute"]
      .agg(
          fraud_rate="mean",
          n="size",
          fraud_count="sum"
      )
      .reindex(countries_to_compare)
)

print("\nComparison of fraud rates for NL, BE, ES, FR:")
print(comparison.to_string(float_format=lambda x: f"{x:.6f}"))

print("\nFraud rates (%) for NL, BE, ES, FR:")
print((comparison["fraud_rate"] * 100).to_string(float_format=lambda x: f"{x:.2f}%"))

