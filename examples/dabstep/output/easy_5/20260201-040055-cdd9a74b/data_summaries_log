#!/usr/bin/env python3
"""
Load and describe the content of fees.json.

- Works with both structured (list of dicts / dict of records) and unstructured JSON.
- Prints essential information (types, keys/columns, sizes).
- Prints the content of fees.json (either fully if small, or a readable truncated preview if large).
- No try/except by request.

Notes:
- All files/documents are in the `data/` directory (relative to the current working directory).
- You may pass an optional path argument; if it's relative and not found, it will be
  resolved relative to the current working directory and then to `data/`.
"""

import json
import os
import sys
from collections.abc import Mapping, Sequence

PREVIEW_ITEMS = 5
PREVIEW_CHARS = 8000
MAX_FULL_PRINT_CHARS = 20000


def is_primitive(x):
    return x is None or isinstance(x, (str, int, float, bool))


def summarize_value(x, depth=0, max_depth=2):
    indent = "  " * depth
    t = type(x).__name__

    if is_primitive(x):
        s = repr(x)
        if len(s) > 200:
            s = s[:200] + "...(truncated)"
        return f"{indent}{t}: {s}"

    if depth >= max_depth:
        if isinstance(x, Mapping):
            return f"{indent}{t} with {len(x)} keys (max depth reached)"
        if isinstance(x, Sequence) and not isinstance(x, (str, bytes, bytearray)):
            return f"{indent}{t} of length {len(x)} (max depth reached)"
        return f"{indent}{t}"

    if isinstance(x, Mapping):
        keys = list(x.keys())
        keys_preview = keys[:20]
        lines = [f"{indent}{t} with {len(keys)} keys"]
        lines.append(f"{indent}Keys preview: {keys_preview}" + ("" if len(keys) <= 20 else " ..."))
        for k in keys_preview[:3]:
            lines.append(f"{indent}- {repr(k)} -> {summarize_value(x[k], depth + 1, max_depth)}")
        return "\n".join(lines)

    if isinstance(x, Sequence) and not isinstance(x, (str, bytes, bytearray)):
        lines = [f"{indent}{t} of length {len(x)}"]
        sample = list(x[: min(len(x), 200)])
        type_counts = {}
        for item in sample:
            type_counts[type(item).__name__] = type_counts.get(type(item).__name__, 0) + 1
        lines.append(f"{indent}Item types (first {len(sample)}): {type_counts}")
        if len(x) > 0:
            lines.append(f"{indent}First item summary:\n{summarize_value(x[0], depth + 1, max_depth)}")
        return "\n".join(lines)

    return f"{indent}{t}"


def infer_columns_from_list_of_dicts(rows):
    cols = set()
    for r in rows:
        if isinstance(r, Mapping):
            cols.update(r.keys())
    return sorted(cols, key=lambda x: str(x))


def print_structured_table_preview(rows, cols):
    print("\n=== Structured data detected: list of objects (rows) ===")
    print(f"Rows: {len(rows)}")
    print(f"Columns ({len(cols)}): {cols}")

    preview_n = min(PREVIEW_ITEMS, len(rows))
    print(f"\nPreviewing first {preview_n} row(s):")
    for i in range(preview_n):
        r = rows[i]
        if not isinstance(r, Mapping):
            print(f"\nRow {i}: (non-dict) {summarize_value(r)}")
            continue
        txt = json.dumps(r, ensure_ascii=False, indent=2)
        if len(txt) > 2000:
            txt = txt[:2000] + "\n...(truncated)"
        print(f"\nRow {i}:\n{txt}")


def print_structured_dict_of_records_preview(obj):
    print("\n=== Structured data detected: dict (record container) ===")
    keys = list(obj.keys())
    print(f"Top-level keys: {len(keys)}")
    print(f"Keys preview: {keys[:20]}" + ("" if len(keys) <= 20 else " ..."))

    sample_keys = keys[: min(len(keys), 200)]
    dict_value_count = sum(1 for k in sample_keys if isinstance(obj[k], Mapping))
    seq_value_count = sum(
        1
        for k in sample_keys
        if isinstance(obj[k], Sequence) and not isinstance(obj[k], (str, bytes, bytearray))
    )

    print(
        f"Value-type scan (first {len(sample_keys)} keys): "
        f"dict-like={dict_value_count}, sequence-like={seq_value_count}"
    )

    if dict_value_count >= max(1, int(0.6 * len(sample_keys))):
        rows = [obj[k] for k in sample_keys if isinstance(obj[k], Mapping)]
        cols = infer_columns_from_list_of_dicts(rows)
        print(f"\nInferred columns from dict values ({len(cols)}): {cols}")
        preview_n = min(PREVIEW_ITEMS, len(keys))
        print(f"\nPreviewing first {preview_n} record(s) (as key -> value):")
        for i, k in enumerate(keys[:preview_n]):
            v = obj[k]
            txt = json.dumps(v, ensure_ascii=False, indent=2) if isinstance(v, (Mapping, list)) else repr(v)
            if len(txt) > 2000:
                txt = txt[:2000] + "\n...(truncated)"
            print(f"\nRecord {i} key={repr(k)}:\n{txt}")
    else:
        print("\nTop-level dict does not look like a uniform record set. Showing summary:")
        print(summarize_value(obj, max_depth=3))


def print_full_or_truncated_json(obj, label="Content"):
    txt = json.dumps(obj, ensure_ascii=False, indent=2)
    print(f"\n=== {label} ===")
    if len(txt) <= MAX_FULL_PRINT_CHARS:
        print(txt)
    else:
        print(txt[:PREVIEW_CHARS])
        print(f"\n...(truncated: printed {min(PREVIEW_CHARS, len(txt))} of {len(txt)} chars)")


def resolve_input_path(arg_path: str | None) -> str:
    """
    Resolution order (no try/except; we just return the best candidate path):
    1) If arg_path is None: default to `data/fees.json` relative to CWD.
    2) If arg_path is absolute: use as-is.
    3) If arg_path is relative:
       - use as-is if it exists from CWD
       - else try `data/<arg_path>` from CWD
    """
    cwd = os.getcwd()

    if arg_path is None:
        return os.path.join(cwd, "data", "fees.json")

    if os.path.isabs(arg_path):
        return arg_path

    if os.path.exists(arg_path):
        return arg_path

    return os.path.join(cwd, "data", arg_path)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    path = resolve_input_path(arg)

    print(f"Loading JSON file: {path}")
    size = os.path.getsize(path)
    print(f"File size: {size} bytes")

    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)

    print("\n=== High-level summary ===")
    print(summarize_value(data, max_depth=3))

    if isinstance(data, list):
        if len(data) > 0 and all(isinstance(x, Mapping) for x in data[: min(len(data), 50)]):
            cols = infer_columns_from_list_of_dicts(data)
            print_structured_table_preview(data, cols)
            print_full_or_truncated_json(data, label="Full JSON content (list)")
        else:
            print("\n=== Unstructured list ===")
            print(f"Length: {len(data)}")
            if len(json.dumps(data, ensure_ascii=False)) <= MAX_FULL_PRINT_CHARS:
                print_full_or_truncated_json(data, label="Full JSON content (list)")
            else:
                print(f"\nPreviewing first {min(PREVIEW_ITEMS, len(data))} item(s):")
                for i, item in enumerate(data[: min(PREVIEW_ITEMS, len(data))]):
                    txt = json.dumps(item, ensure_ascii=False, indent=2) if not is_primitive(item) else repr(item)
                    if len(txt) > 2000:
                        txt = txt[:2000] + "\n...(truncated)"
                    print(f"\nItem {i}:\n{txt}")
                print_full_or_truncated_json(data, label="JSON content (truncated preview)")
    elif isinstance(data, dict):
        print_structured_dict_of_records_preview(data)
        print_full_or_truncated_json(data, label="Full JSON content (dict)")
    else:
        print("\n=== Primitive / scalar JSON ===")
        print(repr(data))
        print("\n=== Full JSON content ===")
        print(json.dumps(data, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()

