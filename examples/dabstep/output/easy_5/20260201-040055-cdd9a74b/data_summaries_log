#!/usr/bin/env python3
"""
Inspect and describe merchant_category_codes.csv.

- Works for structured CSV (rows/columns) or "unstructured" text-like CSV.
- Prints: file path, size, encoding guess, delimiter guess, column names (if any),
  row/column counts, missingness summary, sample rows, and basic per-column stats.
- Prints the content in a safe way:
  - If structured and large: prints a few example rows (head/tail) plus random sample.
  - If unstructured / single-column: prints a text preview and a few parsed lines.
"""

from pathlib import Path
import os
import csv
import io
import sys
import re
import pandas as pd


CSV_PATH = Path("merchant_category_codes.csv")

# Tuning parameters
MAX_FULL_PRINT_CELLS = 2000          # if dataframe has <= this many cells, print all rows
HEAD_ROWS = 10
TAIL_ROWS = 5
RANDOM_SAMPLE_ROWS = 10
TEXT_PREVIEW_CHARS = 8000            # for unstructured-like content preview
MAX_LINES_PREVIEW = 50               # show first N raw lines when unstructured
MAX_UNIQUE_SHOW = 20                 # show up to N uniques for low-cardinality columns


def guess_encoding(raw: bytes) -> str:
    # Simple heuristic: try UTF-8 variants first, then latin-1.
    # No try/except per requirement; so use deterministic checks.
    # We'll check for UTF-8 BOM, else assume UTF-8.
    if raw.startswith(b"\xef\xbb\xbf"):
        return "utf-8-sig"
    return "utf-8"


def guess_delimiter(sample_text: str) -> str:
    # Use csv.Sniffer on a small sample; fallback to comma if ambiguous.
    sniffer = csv.Sniffer()
    dialect = sniffer.sniff(sample_text, delimiters=[",", ";", "\t", "|", ":"])
    return dialect.delimiter


def is_probably_unstructured(df: pd.DataFrame) -> bool:
    # Heuristic: single column with very long strings, or no header inferred.
    if df.shape[1] == 1:
        s = df.iloc[:, 0].astype(str)
        long_frac = (s.str.len() > 200).mean() if len(s) else 0.0
        return long_frac > 0.2
    return False


def print_section(title: str):
    print("\n" + "=" * len(title))
    print(title)
    print("=" * len(title))


def main():
    if not CSV_PATH.exists():
        print(f"File not found: {CSV_PATH.resolve()}")
        print("Place merchant_category_codes.csv in the current working directory or adjust CSV_PATH.")
        sys.exit(1)

    file_size = CSV_PATH.stat().st_size
    abs_path = CSV_PATH.resolve()

    print_section("FILE INFO")
    print(f"Path: {abs_path}")
    print(f"Size: {file_size:,} bytes")
    print(f"CWD:  {Path.cwd()}")

    raw = CSV_PATH.read_bytes()
    encoding = guess_encoding(raw)
    text = raw.decode(encoding, errors="replace")

    print(f"Encoding (heuristic): {encoding}")

    # Prepare a sniffer sample (first ~64KB or full file)
    sample_text = text[:65536]
    delimiter = guess_delimiter(sample_text)
    print(f"Delimiter (sniffed): {repr(delimiter)}")

    # Peek at raw first lines
    print_section("RAW TEXT PREVIEW (first lines)")
    raw_lines = text.splitlines()
    for i, line in enumerate(raw_lines[:MAX_LINES_PREVIEW], start=1):
        print(f"{i:>4}: {line}")
    if len(raw_lines) > MAX_LINES_PREVIEW:
        print(f"... ({len(raw_lines) - MAX_LINES_PREVIEW} more lines)")

    # Read into DataFrame
    # Use engine='python' for robust delimiter handling; keep_default_na to standardize NA parsing.
    df = pd.read_csv(
        CSV_PATH,
        sep=delimiter,
        engine="python",
        encoding=encoding,
        dtype="string",
        keep_default_na=True,
        na_values=["", "NA", "N/A", "null", "NULL", "None", "none"]
    )

    print_section("STRUCTURED VIEW (pandas)")
    print(f"Shape: {df.shape[0]:,} rows x {df.shape[1]:,} columns")
    print("Column names:")
    for idx, col in enumerate(df.columns, start=1):
        print(f"  {idx:>2}. {col}")

    # Basic missingness
    print_section("MISSINGNESS SUMMARY")
    missing = df.isna().sum().sort_values(ascending=False)
    missing_pct = (missing / max(len(df), 1) * 100).round(2)
    miss_df = pd.DataFrame({"missing_count": missing, "missing_pct": missing_pct})
    # Show all columns; it's typically essential info.
    print(miss_df.to_string())

    # Unstructured heuristics
    unstructured = is_probably_unstructured(df)

    # Print content
    print_section("CONTENT")
    total_cells = df.shape[0] * df.shape[1]
    if unstructured:
        print("Detected as likely unstructured / text-like (single column with long strings).")
        col = df.columns[0]
        print(f"Column: {col}")
        joined_preview = "\n".join(df[col].astype(str).head(MAX_LINES_PREVIEW).tolist())
        print("\nPreview (first entries):")
        print(joined_preview[:TEXT_PREVIEW_CHARS])
        if len(joined_preview) > TEXT_PREVIEW_CHARS:
            print(f"... (preview truncated to {TEXT_PREVIEW_CHARS} chars)")
    else:
        if total_cells <= MAX_FULL_PRINT_CELLS and len(df) <= 2000:
            print("Printing full table (small dataset).")
            print(df.to_string(index=False))
        else:
            print(f"Dataset is large (cells: {total_cells:,}); printing examples only.")
            print("\n-- Head --")
            print(df.head(HEAD_ROWS).to_string(index=False))
            print("\n-- Tail --")
            print(df.tail(TAIL_ROWS).to_string(index=False))
            if len(df) >= RANDOM_SAMPLE_ROWS:
                print("\n-- Random sample --")
                print(df.sample(RANDOM_SAMPLE_ROWS, random_state=42).to_string(index=False))

    # Per-column quick stats
    print_section("COLUMN PROFILE (quick stats)")
    for col in df.columns:
        s = df[col]
        non_null = s.dropna()
        print(f"\n[{col}]")
        print(f"  dtype: {s.dtype}")
        print(f"  non-null: {len(non_null):,} / {len(s):,}")
        if len(non_null) == 0:
            continue

        # Try numeric conversion for stats
        numeric = pd.to_numeric(non_null, errors="coerce")
        numeric_nonnull = numeric.dropna()
        if len(numeric_nonnull) >= max(3, int(0.5 * len(non_null))):
            desc = numeric_nonnull.describe(percentiles=[0.25, 0.5, 0.75])
            print("  numeric-like stats:")
            print(desc.to_string())
        else:
            # Categorical/text summary
            nunique = non_null.nunique(dropna=True)
            print(f"  unique: {nunique:,}")
            if nunique <= MAX_UNIQUE_SHOW:
                uniques = non_null.unique().tolist()
                print("  values:")
                for v in uniques:
                    v_str = str(v)
                    v_str = re.sub(r"\s+", " ", v_str).strip()
                    print(f"    - {v_str}")
            else:
                vc = non_null.value_counts().head(10)
                print("  top 10 most frequent:")
                print(vc.to_string())

    print_section("DONE")


if __name__ == "__main__":
    main()

