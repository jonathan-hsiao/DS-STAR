#!/usr/bin/env python3
"""
Inspect and describe the contents of acquirer_countries.csv.

- Works for both structured CSV (tabular) and "unstructured" CSV-like text.
- Prints essential information: size, encoding guess, delimiter guess, column names, dtypes, missingness,
  basic stats, and sample rows.
- Prints file content (raw) up to a configurable limit to avoid flooding the terminal.

Assumption: files live in the `data/` directory (relative to this script).
You can also pass a path as the first CLI argument.
"""

from __future__ import annotations

from pathlib import Path
import csv
import sys
import pandas as pd


DEFAULT_CSV_NAME = "acquirer_countries.csv"
DEFAULT_DIR = "data"

# Limits (adjust if needed)
RAW_BYTES_TO_SHOW = 20000          # raw preview (bytes)
RAW_TAIL_BYTES_TO_SHOW = 8000      # tail preview (bytes)
MAX_ROWS_TO_PRINT = 20             # dataframe sample rows to print
MAX_COLS_TO_PRINT = 50             # avoid huge wide printouts


def guess_encoding(raw: bytes) -> str:
    # Minimal heuristic without external dependencies.
    for enc in ("utf-8", "utf-8-sig", "cp1252", "latin-1"):
        try:
            raw.decode(enc)
            return enc
        except UnicodeDecodeError:
            pass
    return "latin-1"


def guess_dialect(text: str) -> csv.Dialect:
    # Use csv.Sniffer if possible; fall back to excel dialect.
    sample = text[:50000]
    sniffer = csv.Sniffer()
    try:
        return sniffer.sniff(sample, delimiters=[",", ";", "\t", "|"])
    except csv.Error:
        return csv.get_dialect("excel")


def print_header(title: str) -> None:
    print("\n" + "=" * 80)
    print(title)
    print("=" * 80)


def resolve_csv_path() -> Path:
    # Priority:
    # 1) CLI arg if provided
    # 2) data/acquirer_countries.csv relative to CWD
    # 3) data/acquirer_countries.csv relative to script location
    if len(sys.argv) > 1:
        p = Path(sys.argv[1]).expanduser()
        return p if p.is_absolute() else (Path.cwd() / p)

    candidate_cwd = Path.cwd() / DEFAULT_DIR / DEFAULT_CSV_NAME
    if candidate_cwd.exists():
        return candidate_cwd

    script_dir = Path(__file__).resolve().parent if "__file__" in globals() else Path.cwd()
    candidate_script = script_dir / DEFAULT_DIR / DEFAULT_CSV_NAME
    return candidate_script


def main() -> None:
    csv_path = resolve_csv_path()
    if not csv_path.exists():
        raise FileNotFoundError(
            "File not found. Looked for:\n"
            f"  - {csv_path.resolve()}\n\n"
            "Provide a path as an argument, e.g.:\n"
            "  python inspect_csv.py data/acquirer_countries.csv"
        )

    raw = csv_path.read_bytes()
    size_bytes = len(raw)
    enc = guess_encoding(raw)
    text = raw.decode(enc, errors="replace")

    print_header("FILE INFO")
    print(f"Path: {csv_path.resolve()}")
    print(f"Size: {size_bytes:,} bytes")
    print(f"Encoding (guessed): {enc}")

    print_header("RAW CONTENT (HEAD PREVIEW)")
    head_bytes = raw[:RAW_BYTES_TO_SHOW]
    print(head_bytes.decode(enc, errors="replace"))
    if size_bytes > RAW_BYTES_TO_SHOW:
        print(f"\n...[truncated raw preview at {RAW_BYTES_TO_SHOW:,} bytes]...")

    if size_bytes > RAW_TAIL_BYTES_TO_SHOW:
        print_header("RAW CONTENT (TAIL PREVIEW)")
        tail_bytes = raw[-RAW_TAIL_BYTES_TO_SHOW:]
        print(tail_bytes.decode(enc, errors="replace"))
        print(f"\n...[showing last {RAW_TAIL_BYTES_TO_SHOW:,} bytes]...")

    print_header("CSV DIALECT (GUESSED)")
    dialect = guess_dialect(text)
    print(f"Delimiter: {repr(dialect.delimiter)}")
    print(f"Quotechar: {repr(dialect.quotechar)}")
    print(f"Doublequote: {dialect.doublequote}")
    print(f"Escapechar: {repr(dialect.escapechar)}")
    print(f"Skipinitialspace: {dialect.skipinitialspace}")
    print(f"Lineterminator: {repr(dialect.lineterminator)}")

    print_header("PANDAS LOAD (STRUCTURED VIEW)")
    df = pd.read_csv(
        csv_path,
        sep=dialect.delimiter,
        quotechar=dialect.quotechar,
        escapechar=dialect.escapechar,
        engine="python",
        dtype_backend="numpy_nullable",
        on_bad_lines="warn",
    )

    print(f"DataFrame shape: {df.shape[0]:,} rows x {df.shape[1]:,} columns")

    print("\nColumns:")
    cols = list(df.columns)
    if len(cols) <= MAX_COLS_TO_PRINT:
        print(cols)
    else:
        print(cols[:MAX_COLS_TO_PRINT])
        print(f"... (+{len(cols) - MAX_COLS_TO_PRINT} more columns)")

    print_header("DTYPES & MISSINGNESS")
    dtype_series = df.dtypes.astype(str)
    missing = df.isna().sum()
    missing_pct = (missing / len(df) * 100) if len(df) else missing.astype(float)

    summary = pd.DataFrame(
        {
            "dtype": dtype_series,
            "missing": missing,
            "missing_%": missing_pct.round(2),
            "n_unique": df.nunique(dropna=True),
        }
    ).sort_values(["missing", "n_unique"], ascending=[False, False])

    pd.set_option("display.max_rows", min(200, max(30, len(summary))))
    pd.set_option("display.max_columns", 20)
    pd.set_option("display.width", 140)
    print(summary)

    print_header("DESCRIBE (NUMERIC)")
    numeric_cols = df.select_dtypes(include=["number"]).columns
    if len(numeric_cols) == 0:
        print("No numeric columns detected.")
    else:
        print(df[numeric_cols].describe().transpose())

    print_header("DESCRIBE (NON-NUMERIC / ALL)")
    print(df.describe(include="all").transpose())

    print_header("CONTENT (SAMPLE ROWS)")
    pd.set_option("display.max_columns", min(MAX_COLS_TO_PRINT, df.shape[1]))
    pd.set_option("display.max_colwidth", 200)
    pd.set_option("display.width", 180)

    if len(df) <= MAX_ROWS_TO_PRINT:
        print(df)
    else:
        print(df.head(MAX_ROWS_TO_PRINT))
        print(f"\n...[showing first {MAX_ROWS_TO_PRINT} rows out of {len(df):,}]...")

    print_header("LOW-CARDINALITY VALUE COUNTS (TOP 10)")
    low_card_cols = [c for c in df.columns if df[c].nunique(dropna=True) <= 20]
    if not low_card_cols:
        print("No low-cardinality columns (<=20 unique values) found.")
    else:
        for c in low_card_cols[:20]:
            print(f"\nColumn: {c} (unique={df[c].nunique(dropna=True)}, missing={df[c].isna().sum()})")
            print(df[c].value_counts(dropna=False).head(10))

    print_header("FULL CONTENT (STRUCTURED PRINT)")
    if df.shape[0] <= 200 and df.shape[1] <= 50:
        print(df.to_string(index=False))
    else:
        print(
            f"Dataset is large ({df.shape[0]:,}x{df.shape[1]:,}). "
            f"Printed sample above. To print everything, consider:\n"
            f"  - df.to_csv(sys.stdout, index=False)\n"
            f"  - increasing limits in this script\n"
        )


if __name__ == "__main__":
    main()
