#!/usr/bin/env python3
"""
payments_inspect.py

Loads and describes the content of data/payments.csv (structured or unstructured).
- Prints essential info (file size, encoding guess, first bytes, newline stats).
- Reads as a CSV into pandas (if parseable) and prints schema + sample rows.
- If the file looks unstructured / single-column, prints raw line samples too.

No try/except blocks per request.
"""

from pathlib import Path
import csv
import pandas as pd


def human_bytes(n: int) -> str:
    units = ["B", "KB", "MB", "GB", "TB"]
    i = 0
    x = float(n)
    while x >= 1024 and i < len(units) - 1:
        x /= 1024.0
        i += 1
    return f"{x:.2f} {units[i]}"


def guess_encoding(path: Path) -> str:
    raw = path.read_bytes()[:65536]
    if raw.startswith(b"\xef\xbb\xbf"):
        return "utf-8-sig"
    raw.decode("utf-8")  # raises UnicodeDecodeError if not valid UTF-8
    return "utf-8"


def sniff_dialect_and_header(path: Path, encoding: str):
    sample = path.read_text(encoding=encoding, errors="strict")[:200000]
    sniffer = csv.Sniffer()
    dialect = sniffer.sniff(sample)
    has_header = sniffer.has_header(sample)
    return dialect, has_header


def compute_newline_stats(text: str):
    return {
        "lines_total": text.count("\n") + (0 if text.endswith("\n") or len(text) == 0 else 1),
        "contains_crlf": "\r\n" in text,
        "contains_cr_only": ("\r" in text) and ("\r\n" not in text),
    }


def basic_text_stats(text: str):
    nonprintable = sum(1 for ch in text[:200000] if ord(ch) < 9 or (13 < ord(ch) < 32))
    return {
        "sample_chars": min(len(text), 200000),
        "nonprintable_in_sample": nonprintable,
        "empty_lines_in_sample": sum(1 for line in text[:200000].splitlines() if line.strip() == ""),
    }


def preview_raw_lines(path: Path, encoding: str, n: int = 20):
    lines = path.read_text(encoding=encoding, errors="strict").splitlines()
    print(f"\n--- Raw line preview (first {min(n, len(lines))} lines) ---")
    for i, line in enumerate(lines[:n], start=1):
        t = line if len(line) <= 300 else line[:300] + " ... [truncated]"
        print(f"{i:>4}: {t}")
    if len(lines) > n:
        print(f"... ({len(lines) - n} more lines not shown)")


def describe_dataframe(df: pd.DataFrame, max_examples: int = 5):
    print("\n=== Structured view (pandas DataFrame) ===")
    print(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")

    print("\nColumn names:")
    for c in df.columns:
        print(f" - {c}")

    print("\nDtypes:")
    print(df.dtypes.to_string())

    print("\nMissing values per column (top 50 shown if many):")
    na = df.isna().sum().sort_values(ascending=False)
    if len(na) > 50:
        print(na.head(50).to_string())
        print(f"... ({len(na) - 50} more columns not shown)")
    else:
        print(na.to_string())

    print("\nSample rows:")
    n = min(max_examples, len(df))
    if n == 0:
        print("(no rows)")
    else:
        print(df.head(n).to_string(index=False))

    print("\nValue examples for each column (up to 5 unique values):")
    for c in df.columns:
        vals = df[c].dropna().unique()
        show = vals[:5]
        show_str = ", ".join(repr(v) for v in show)
        more = "" if len(vals) <= 5 else f", ... (+{len(vals) - 5} more)"
        print(f" - {c}: {show_str}{more}")

    print("\nDescribe (numeric columns):")
    num = df.select_dtypes(include="number")
    if num.shape[1] == 0:
        print("(no numeric columns detected)")
    else:
        print(num.describe().to_string())

    print("\nDescribe (object/text columns; top counts for up to 10 columns):")
    obj_cols = df.select_dtypes(include=["object", "string"]).columns.tolist()
    if not obj_cols:
        print("(no object/text columns detected)")
    else:
        for c in obj_cols[:10]:
            vc = df[c].astype("string").value_counts(dropna=False).head(10)
            print(f"\nTop values for {c!r}:")
            print(vc.to_string())
        if len(obj_cols) > 10:
            print(f"\n... ({len(obj_cols) - 10} more object/text columns not shown)")


def resolve_input_path() -> Path:
    # All files/documents are in data/ directory.
    # Prefer ./data/payments.csv; if script is run from elsewhere, also try relative to script dir.
    cwd_candidate = Path("data") / "payments.csv"
    script_candidate = Path(__file__).resolve().parent / "data" / "payments.csv"
    return cwd_candidate if cwd_candidate.exists() else script_candidate


def main():
    path = resolve_input_path()

    size = path.stat().st_size
    print(f"File: {path.resolve()}")
    print(f"Size: {size} bytes ({human_bytes(size)})")

    encoding = guess_encoding(path)
    print(f"Guessed encoding: {encoding}")

    raw_head = path.read_bytes()[:256]
    print("\n--- First 256 bytes (repr) ---")
    print(repr(raw_head))

    text_full = path.read_text(encoding=encoding, errors="strict")
    nl_stats = compute_newline_stats(text_full)
    tx_stats = basic_text_stats(text_full)
    print("\n--- Text/Newline stats ---")
    for k, v in {**nl_stats, **tx_stats}.items():
        print(f"{k}: {v}")

    dialect, has_header = sniff_dialect_and_header(path, encoding)
    print("\n--- CSV sniff ---")
    print(f"Delimiter: {repr(dialect.delimiter)}")
    print(f"Quotechar: {repr(dialect.quotechar)}")
    print(f"Escapechar: {repr(dialect.escapechar)}")
    print(f"Doublequote: {dialect.doublequote}")
    print(f"Skipinitialspace: {dialect.skipinitialspace}")
