#!/usr/bin/env python3
"""
Single-file program to load, print, and describe data/merchant_data.json.

- Handles both structured (list/dict of records) and unstructured JSON.
- Prints the content (pretty-printed) and essential summary information.
- If there are many records/keys, prints only a few examples.
- No try/except blocks.
"""

import json
import os
from collections.abc import Mapping, Sequence

DATA_DIR = "data"
FILE_NAME = "merchant_data.json"
FILE_PATH = os.path.join(DATA_DIR, FILE_NAME)

MAX_PRINT_CHARS = 20000      # limit for raw pretty print to avoid huge console output
MAX_EXAMPLE_ITEMS = 5        # examples of records/items to show
MAX_KEYS_PREVIEW = 80        # keys to show in key lists
MAX_UNIQUE_PREVIEW = 10      # sample unique values per column


def is_primitive(x):
    return x is None or isinstance(x, (str, int, float, bool))


def pretty_json(obj):
    return json.dumps(obj, ensure_ascii=False, indent=2, sort_keys=False)


def truncate_text(s, max_chars=MAX_PRINT_CHARS):
    if len(s) <= max_chars:
        return s
    return s[:max_chars] + f"\n... [TRUNCATED: showing first {max_chars} chars out of {len(s)}]"


def get_shape(obj):
    if isinstance(obj, Mapping):
        return {"type": "object", "num_keys": len(obj)}
    if isinstance(obj, Sequence) and not isinstance(obj, (str, bytes, bytearray)):
        return {"type": "array", "length": len(obj)}
    return {"type": type(obj).__name__}


def iter_records(data):
    """
    Return (records, mode) where mode indicates how to interpret:
    - "list_of_dicts": data is list[dict]
    - "dict_of_records": data is dict[str->dict] or dict[int->dict]
    - "single_dict": data is dict but not a record-collection
    - "other": not tabular
    """
    if isinstance(data, list) and all(isinstance(x, Mapping) for x in data):
        return data, "list_of_dicts"
    if isinstance(data, Mapping):
        values = list(data.values())
        if values and all(isinstance(v, Mapping) for v in values):
            return values, "dict_of_records"
        return None, "single_dict"
    return None, "other"


def union_columns(records):
    cols = set()
    for r in records:
        cols.update(r.keys())
    return sorted(cols)


def infer_type(value):
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "bool"
    if isinstance(value, int) and not isinstance(value, bool):
        return "int"
    if isinstance(value, float):
        return "float"
    if isinstance(value, str):
        return "str"
    if isinstance(value, Mapping):
        return "object"
    if isinstance(value, list):
        return "array"
    return type(value).__name__


def summarize_records(records):
    n = len(records)
    cols = union_columns(records)
    print("\n=== Structured Data Summary ===")
    print(f"Records: {n}")
    print(f"Columns ({len(cols)}):")
    if len(cols) <= MAX_KEYS_PREVIEW:
        print("  " + ", ".join(cols))
    else:
        print("  " + ", ".join(cols[:MAX_KEYS_PREVIEW]) + f", ... (+{len(cols)-MAX_KEYS_PREVIEW} more)")

    print("\nColumn statistics (non-null count, types, sample values):")
    for col in cols:
        non_null = 0
        types = {}
        uniques = []
        seen = set()
        for r in records:
            v = r.get(col, None)
            if v is None:
                continue
            non_null += 1
            t = infer_type(v)
            types[t] = types.get(t, 0) + 1

            if is_primitive(v):
                key = (t, v)
                if key not in seen and len(uniques) < MAX_UNIQUE_PREVIEW:
                    seen.add(key)
                    uniques.append(v)

        type_desc = ", ".join(f"{k}:{v}" for k, v in sorted(types.items(), key=lambda x: (-x[1], x[0])))
        if not type_desc:
            type_desc = "all null/missing"

        sample_desc = f" | sample values: {uniques}" if uniques else ""
        print(f"- {col}: non-null {non_null}/{n} | types: {type_desc}{sample_desc}")

    print(f"\nExample records (showing up to {MAX_EXAMPLE_ITEMS}):")
    for i, r in enumerate(records[:MAX_EXAMPLE_ITEMS], start=1):
        print(f"\n--- Record {i} ---")
        print(truncate_text(pretty_json(r), max_chars=4000))


def describe_unstructured(data):
    print("\n=== Unstructured/Non-tabular Summary ===")
    shape = get_shape(data)
    print("Top-level:", shape)

    if isinstance(data, Mapping):
        keys = list(data.keys())
        print(f"Top-level keys ({len(keys)}):")
        if len(keys) <= MAX_KEYS_PREVIEW:
            print("  " + ", ".join(map(str, keys)))
        else:
            print("  " + ", ".join(map(str, keys[:MAX_KEYS_PREVIEW])) + f", ... (+{len(keys)-MAX_KEYS_PREVIEW} more)")

        print("\nKey -> type preview (up to first 30 keys):")
        for k in keys[:30]:
            v = data[k]
            print(f"- {k}: {infer_type(v)}")
            if isinstance(v, (Mapping, list)):
                subshape = get_shape(v)
                print(f"    shape: {subshape}")

        print("\nExample content (first few key-value pairs):")
        preview = {k: data[k] for k in keys[:min(len(keys), MAX_EXAMPLE_ITEMS)]}
        print(truncate_text(pretty_json(preview), max_chars=4000))

    elif isinstance(data, list):
        print(f"List length: {len(data)}")
        print(f"\nExample list items (showing up to {MAX_EXAMPLE_ITEMS}):")
        for i, item in enumerate(data[:MAX_EXAMPLE_ITEMS], start=1):
            print(f"\n--- Item {i} ({infer_type(item)}) ---")
            text = pretty_json(item) if isinstance(item, (Mapping, list)) else repr(item)
            print(truncate_text(text, max_chars=4000))

        if data and all(is_primitive(x) for x in data):
            counts = {}
            for x in data:
                counts[x] = counts.get(x, 0) + 1
            top = sorted(counts.items(), key=lambda kv: (-kv[1], str(kv[0])))[:20]
            print("\nTop value counts (up to 20):")
            for val, cnt in top:
                print(f"- {val!r}: {cnt}")
    else:
        print("Value:", repr(data))


def main():
    abs_path = os.path.abspath(FILE_PATH)
    print(f"Reading: {abs_path}")
    assert os.path.exists(FILE_PATH), f"File not found: {abs_path}"

    with open(FILE_PATH, "r", encoding="utf-8") as f:
        data = json.load(f)

    print("\n=== Raw JSON Content (pretty-printed) ===")
    raw = pretty_json(data)
    print(truncate_text(raw, max_chars=MAX_PRINT_CHARS))

    records, mode = iter_records(data)
    if mode in ("list_of_dicts", "dict_of_records") and records is not None:
        summarize_records(records)
    else:
        describe_unstructured(data)


if __name__ == "__main__":
    main()

