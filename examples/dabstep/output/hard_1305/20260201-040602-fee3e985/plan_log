# Helpers: treat empty list as wildcard (matches anything)
def list_is_wildcard(x):
    return isinstance(x, list) and len(x) == 0

def list_contains_or_wildcard(x, target):
    if x is None:
        return False
    if list_is_wildcard(x):
        return True
    return isinstance(x, list) and (target in x)

# Filters per spec:
# - card_scheme == "GlobalCard"
