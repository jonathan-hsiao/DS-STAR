import json
import pandas as pd

# Step #2: Filter fees.json and compute average fee for eur_amount=10

fees_path = "/Users/jonathan/github/DS-STAR/examples/dabstep/data/fees.json"
with open(fees_path, "r") as f:
    fees_data = json.load(f)

fees_df = pd.DataFrame(fees_data)

print("fees.json loaded.")
print("Shape:", fees_df.shape)
print("Columns:", list(fees_df.columns))

TARGET_SCHEME = "GlobalCard"
TARGET_ACCOUNT_TYPE = "H"
TARGET_MCC = 5812
EUR_AMOUNT = 10.0

def account_type_allows_h(val):
    """
    account_type is stored as a list in fees.json.
    Business rule: allow if it contains 'H' OR is empty (meaning applies to all).
    """
    if isinstance(val, list):
        return (TARGET_ACCOUNT_TYPE in val) or (len(val) == 0)
    # if malformed/unexpected, be conservative
    return False

def mcc_includes_target(val):
    """
    merchant_category_code is stored as a list in fees.json.
    Allow if list contains the target MCC.
    """
    if isinstance(val, list):
        return TARGET_MCC in val
    # if malformed/unexpected, be conservative
    return False

filtered = fees_df[
    (fees_df["card_scheme"] == TARGET_SCHEME)
    & (fees_df["account_type"].apply(account_type_allows_h))
    & (fees_df["merchant_category_code"].apply(mcc_includes_target))
].copy()

print("\nFiltered fee rows (GlobalCard, account_type includes H or empty, MCC includes 5812):")
print("Count:", len(filtered))

if len(filtered) == 0:
    print("No matching fee rules found; cannot compute average fee.")
else:
    # compute fee for eur_amount=10 as fixed_amount + (rate/10000)*10
    filtered["fee_for_10_eur"] = filtered["fixed_amount"].astype(float) + (filtered["rate"].astype(float) / 10000.0) * EUR_AMOUNT

    avg_fee = filtered["fee_for_10_eur"].mean()

    print("\nSample of matching rows (ID, fixed_amount, rate, fee_for_10_eur):")
    cols_to_show = [c for c in ["ID", "fixed_amount", "rate", "fee_for_10_eur", "account_type", "merchant_category_code"] if c in filtered.columns]
    print(filtered[cols_to_show].head(20).to_string(index=False))

    print("\nComputed average fee for eur_amount=10:")
    print("Average fee:", avg_fee)

