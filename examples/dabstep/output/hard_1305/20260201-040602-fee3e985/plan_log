mask_mcc = fees_df["merchant_category_code"].apply(lambda v: list_contains_or_wildcard(v, 5812))

matched = fees_df[mask_scheme & mask_acct & mask_mcc].copy()
print("\nMatched rows:", len(matched))

if len(matched) == 0:
