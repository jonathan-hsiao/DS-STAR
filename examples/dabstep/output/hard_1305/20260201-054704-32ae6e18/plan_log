import json
from pathlib import Path

# Paths
fees_path = Path("data/fees.json")

# Load fees.json
with fees_path.open("r", encoding="utf-8") as f:
    fees = json.load(f)

print(f"Loaded fees.json records: {len(fees)}")

TARGET_SCHEME = "GlobalCard"
TARGET_ACCOUNT_TYPE = "H"
TARGET_MCC = 5812  # Eating Places and Restaurants

# Step #1: Filter per plan
filtered = []
for row in fees:
    if row.get("card_scheme") != TARGET_SCHEME:
        continue

    account_types = row.get("account_type") or []
    if TARGET_ACCOUNT_TYPE not in account_types:
        continue

    mcc_list = row.get("merchant_category_code") or []
    if TARGET_MCC not in mcc_list:
        continue

    filtered.append(row)

print(
    f"Filtered records (scheme={TARGET_SCHEME}, account_type contains '{TARGET_ACCOUNT_TYPE}', MCC includes {TARGET_MCC}): {len(filtered)}"
)

# Show key fields for quick verification
if filtered:
    print("Matching IDs and key fields:")
    for r in filtered:
        print(
            {
                "ID": r.get("ID"),
                "card_scheme": r.get("card_scheme"),
                "account_type": r.get("account_type"),
                "merchant_category_code": r.get("merchant_category_code"),
                "is_credit": r.get("is_credit"),
                "aci": r.get("aci"),
                "capture_delay": r.get("capture_delay"),
                "monthly_fraud_level": r.get("monthly_fraud_level"),
                "monthly_volume": r.get("monthly_volume"),
                "rate": r.get("rate"),
                "fixed_amount": r.get("fixed_amount"),
                "intracountry": r.get("intracountry"),
            }
        )
else:
    print("No matches found. (This can happen if the fee rules don't include that exact combination.)")

# Step #2: Compute each fee for a 10 EUR transaction, then take the mean
TX_EUR = 10.0

if len(filtered) != 3:
    print(
        f"WARNING: Expected 3 matching fee rules per plan step, but found {len(filtered)}. Proceeding with available matches."
    )

fees_for_tx = []
for r in filtered:
    fixed_amount = float(r.get("fixed_amount") or 0.0)
    rate = float(r.get("rate") or 0.0)  # rate is in basis points where 10000 = 100%
    fee = fixed_amount + (rate / 10000.0) * TX_EUR
    fees_for_tx.append(fee)

    print(
        f"Rule ID={r.get('ID')}: fixed_amount={fixed_amount:.4f}, rate={rate:.4f} -> fee_for_{TX_EUR:.2f}_EUR={fee:.6f}"
    )

if fees_for_tx:
    mean_fee = sum(fees_for_tx) / len(fees_for_tx)
    print(f"Mean fee across {len(fees_for_tx)} rule(s) for {TX_EUR:.2f} EUR: {mean_fee:.6f}")
else:
    print("No fees to compute mean from (no matching rules).")

