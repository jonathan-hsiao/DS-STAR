Plan:
Step #1: Load `inventory.csv` and `discounts.csv` into dataframes and join them on the `product` column so each item has its quantity, price, and discount_pct in one table.

Step #2: Add a column `discounted_value = quantity * price * (1 - discount_pct/100)` to the merged table, then sum `discounted_value` to get the total value after discounts.

Code:
import pandas as pd

# Load data
inventory_path = "/Users/jonathan/github/DS-STAR/examples/example_1/data/inventory.csv"
discounts_path = "/Users/jonathan/github/DS-STAR/examples/example_1/data/discounts.csv"

inventory = pd.read_csv(inventory_path)
discounts = pd.read_csv(discounts_path)

print("Inventory dtypes (before casting):")
print(inventory.dtypes)
print("\nDiscounts dtypes:")
print(discounts.dtypes)

# Cast numeric-like columns from inventory to numeric
inventory["quantity"] = pd.to_numeric(inventory["quantity"], errors="raise")
inventory["price"] = pd.to_numeric(inventory["price"], errors="raise")

# Join on product
merged = inventory.merge(discounts, on="product", how="left", validate="one_to_one")

print("\nMerged table (inventory + discounts):")
print(merged)

# Sanity check for missing discounts after join (should be none with provided data)
missing_discounts = merged["discount_pct"].isna().sum()
print(f"\nMissing discount_pct after join: {missing_discounts}")

# Step #2: Compute discounted_value and total value after discounts
merged["discounted_value"] = merged["quantity"] * merged["price"] * (1 - merged["discount_pct"] / 100)

print("\nMerged table with discounted_value:")
print(merged)

total_value_after_discounts = merged["discounted_value"].sum()
print(f"\nTotal value after discounts: {total_value_after_discounts:.2f}")

