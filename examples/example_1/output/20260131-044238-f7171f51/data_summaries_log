#!/usr/bin/env python3
"""
Inspect and describe the content of `data/discounts.csv`.

- Works for both structured (tabular) and unstructured (single-column / messy) CSV-like files.
- Prints essential info: file size, encoding guess, delimiter guess, column names (if any),
  row/column counts, dtype summary, missingness, duplicates, basic numeric stats, and examples.
- Prints content preview (head/tail) and, if file is small enough, prints the entire file.
- No try/except blocks.
"""

from pathlib import Path
import csv
import io
import re
import pandas as pd


def read_bytes(path: Path, n: int) -> bytes:
    with path.open("rb") as f:
        return f.read(n)


def detect_encoding(raw: bytes) -> str:
    # Minimal, dependency-free encoding guesser
    if raw.startswith(b"\xef\xbb\xbf"):
        return "utf-8-sig"
    raw.decode("utf-8")
    return "utf-8"


def guess_delimiter(text_sample: str) -> str:
    sniffer = csv.Sniffer()
    dialect = sniffer.sniff(text_sample, delimiters=[",", ";", "\t", "|"])
    return dialect.delimiter


def looks_like_header(fields) -> bool:
    non_empty = [f for f in fields if f.strip() != ""]
    if not non_empty:
        return False
    numeric_like = 0
    for f in non_empty:
        s = f.strip().strip('"').strip("'")
        if re.fullmatch(r"[-+]?\d+(\.\d+)?", s):
            numeric_like += 1
    return numeric_like <= max(1, int(0.3 * len(non_empty)))


def print_section(title: str):
    line = "=" * len(title)
    print(f"\n{title}\n{line}")


def main():
    path = Path("data") / "discounts.csv"
    size_bytes = path.stat().st_size

    print_section("FILE")
    print(f"Path: {path.resolve()}")
    print(f"Size: {size_bytes:,} bytes")

    raw = read_bytes(path, min(size_bytes, 256_000))
    encoding = detect_encoding(raw)
    text_sample = raw.decode(encoding, errors="strict")

    sample_for_sniff = text_sample[:50_000]
    delimiter = guess_delimiter(sample_for_sniff)

    print_section("PARSING GUESS")
    print(f"Encoding guess: {encoding}")
    print(f"Delimiter guess: {repr(delimiter)}")

    with path.open("r", encoding=encoding, newline="") as f:
        first_lines = []
        for _ in range(20):
            line = f.readline()
            if line == "":
                break
            first_lines.append(line.rstrip("\n"))

    print_section("RAW PREVIEW (first 20 lines)")
    if first_lines:
        for i, line in enumerate(first_lines, 1):
            print(f"{i:02d}: {line}")
    else:
        print("(empty file)")

    first_row_fields = next(csv.reader([first_lines[0]], delimiter=delimiter)) if first_lines else []
    header_present = looks_like_header(first_row_fields)

    print_section("STRUCTURE HEURISTICS")
    print(f"First row fields count: {len(first_row_fields)}")
    print(f"First row fields: {first_row_fields}")
    print(f"Header likely present: {header_present}")

    header_arg = 0 if header_present else None

    df = pd.read_csv(
        path,
        encoding=encoding,
        sep=delimiter,
        header=header_arg,
        dtype_backend="numpy_nullable",
        engine="python",
    )

    print_section("DATAFRAME OVERVIEW")
    print(f"Shape: {df.shape[0]:,} rows x {df.shape[1]:,} columns")
    if header_present:
        print("Column names:")
        print(list(df.columns))
    else:
        print("No header detected. Assigned column names:")
        print(list(df.columns))

    print_section("DTYPES & NON-NULL COUNTS")
    info_buf = io.StringIO()
    df.info(buf=info_buf, show_counts=True)
    print(info_buf.getvalue().rstrip())

    print_section("MISSING VALUES (top 30 columns by missing count)")
    missing = df.isna().sum().sort_values(ascending=False)
    if df.shape[1] > 0:
        top_missing = missing.head(min(30, len(missing)))
        print(top_missing.to_string())
    else:
        print("(no columns)")

    print_section("DUPLICATES")
    dup_count = df.duplicated().sum()
    print(f"Duplicate rows (exact match across all columns): {int(dup_count):,}")

    print_section("NUMERIC SUMMARY (describe)")
    num_desc = df.describe(include=["number"]).T
    if len(num_desc) == 0:
        print("(no numeric columns detected)")
    else:
        print(num_desc.to_string())

    print_section("CATEGORICAL/OBJECT-LIKE COLUMNS (top value counts, limited)")
    cat_cols = [c for c in df.columns if not pd.api.types.is_numeric_dtype(df[c])]
    if not cat_cols:
        print("(no non-numeric columns detected)")
    else:
        max_cols = min(10, len(cat_cols))
        for c in cat_cols[:max_cols]:
            print(f"\nColumn: {c}")
            vc = df[c].astype("string").value_counts(dropna=False).head(10)
            print(vc.to_string())
        if len(cat_cols) > max_cols:
            print(f"\n... ({len(cat_cols) - max_cols} more non-numeric columns not shown)")

    print_section("EXAMPLES (structured preview)")
    max_rows_preview = 10
    if df.shape[0] == 0:
        print("(no rows)")
    else:
        print("\nHead:")
        print(df.head(max_rows_preview).to_string(index=False))
        if df.shape[0] > max_rows_preview:
            print("\nTail:")
            print(df.tail(max_rows_preview).to_string(index=False))
        if df.shape[0] > 50:
            print("\nRandom sample (10 rows):")
            print(df.sample(10, random_state=0).to_string(index=False))

    print_section("CONTENT OUTPUT")
    if size_bytes <= 200_000 and df.shape[0] <= 5_000:
        print("Printing entire content (file is small enough):\n")
        print(df.to_string(index=False))
    else:
        print("File seems large; printing limited content:")
        print("\n--- HEAD (first 50 rows) ---")
        print(df.head(50).to_string(index=False))
        print("\n--- TAIL (last 50 rows) ---")
        print(df.tail(50).to_string(index=False))


if __name__ == "__main__":
    main()
