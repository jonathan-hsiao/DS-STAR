#!/usr/bin/env python3
"""
inventory_inspector.py

Loads and describes the content of `data/inventory.csv`, handling both structured
(tabular) and unstructured (single-column / irregular) CSV-like text.

No try/except is used by design (per requirements).
"""

import os
import csv
import re
from collections import Counter

import pandas as pd


def is_numeric_series(s: pd.Series) -> bool:
    if s.empty:
        return False
    coerced = pd.to_numeric(s, errors="coerce")
    non_null = s.notna().sum()
    if non_null == 0:
        return False
    return (coerced.notna().sum() / non_null) >= 0.9


def is_datetime_series(s: pd.Series) -> bool:
    if s.empty:
        return False
    coerced = pd.to_datetime(s, errors="coerce", infer_datetime_format=True)
    non_null = s.notna().sum()
    if non_null == 0:
        return False
    return (coerced.notna().sum() / non_null) >= 0.9


def summarize_dataframe(df: pd.DataFrame, max_rows_show: int = 15, max_cols_show: int = 30):
    print("\n=== BASIC INFO ===")
    print(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")

    print("\n=== COLUMN NAMES ===")
    for i, col in enumerate(df.columns, 1):
        print(f"{i:>3}. {col!r}")

    print("\n=== COLUMN SUMMARY (dtype, missing, unique, hints) ===")
    for col in df.columns:
        s = df[col]
        missing = int(s.isna().sum())
        unique = int(s.nunique(dropna=True))
        dtype = str(s.dtype)

        hints = []
        if is_numeric_series(s):
            hints.append("numeric-like")
        if is_datetime_series(s):
            hints.append("datetime-like")
        if df.shape[0] > 0 and (missing / df.shape[0]) > 0.95:
            hints.append("mostly-missing")

        hint_str = (", ".join(hints)) if hints else "-"
        print(f"- {col!r}: dtype={dtype}, missing={missing}, unique={unique}, hints={hint_str}")

    print("\n=== DESCRIBE (numeric) ===")
    num_df = df.select_dtypes(include="number")
    if num_df.shape[1] > 0:
        print(num_df.describe(include="all").transpose())
    else:
        print("(No numeric columns detected.)")

    print("\n=== DESCRIBE (object/categorical) ===")
    obj_cols = [c for c in df.columns if df[c].dtype == "object" or str(df[c].dtype).startswith("string")]
    if obj_cols:
        show_cols = obj_cols[: min(10, len(obj_cols))]
        for c in show_cols:
            s = df[c].dropna().astype(str)
            print(f"\nColumn: {c!r}")
            if s.empty:
                print("(All values missing.)")
                continue
            vc = s.value_counts().head(10)
            print("Top values:")
            for k, v in vc.items():
                ks = k if len(k) <= 200 else (k[:200] + "…")
                print(f"  {ks!r}: {int(v)}")
            uniq = s.unique()
            sample = uniq[: min(10, len(uniq))]
            print("Sample unique values:")
            for val in sample:
                vs = val if len(val) <= 200 else (val[:200] + "…")
                print(f"  {vs!r}")
        if len(obj_cols) > 10:
            print(f"\n(Only first 10 object-like columns summarized; total object-like columns: {len(obj_cols)})")
    else:
        print("(No object/categorical columns detected.)")

    print("\n=== CONTENT PREVIEW ===")
    preview_df = df
    if df.shape[1] > max_cols_show:
        preview_df = df.iloc[:, :max_cols_show]
        print(f"(Preview limited to first {max_cols_show} columns out of {df.shape[1]})")

    n_show = min(max_rows_show, df.shape[0])
    if n_show > 0:
        print(preview_df.head(n_show).to_string(index=False))
    else:
        print("(No rows.)")

    if df.shape[0] > n_show:
        print(f"\n(Preview limited to first {n_show} rows out of {df.shape[0]})")


def read_raw_stats(path: str, max_lines: int = 2000):
    size = os.path.getsize(path)
    with open(path, "r", encoding="utf-8", newline="") as f:
        lines = []
        for i, line in enumerate(f):
            lines.append(line.rstrip("\n"))
            if i + 1 >= max_lines:
                break

    non_empty = [ln for ln in lines if ln.strip() != ""]
    first_nonempty = non_empty[0] if non_empty else ""
    print("\n=== RAW FILE STATS (first chunk) ===")
    print(f"Path: {os.path.abspath(path)}")
    print(f"Size: {size} bytes")
    print(f"Lines read for inspection: {len(lines)} (max {max_lines})")
    print(f"First non-empty line (truncated): {first_nonempty[:300]!r}")


def sniff_delimiter(path: str, sample_bytes: int = 100_000) -> str:
    with open(path, "r", encoding="utf-8", newline="") as f:
        sample = f.read(sample_bytes)

    sample_nonempty = "\n".join([ln for ln in sample.splitlines() if ln.strip()][:50]).strip()
    if not sample_nonempty:
        return ","

    dialect = csv.Sniffer().sniff(sample_nonempty, delimiters=[",", ";", "\t", "|"])
    return dialect.delimiter


def load_as_dataframe(path: str, delimiter: str) -> pd.DataFrame:
    df = pd.read_csv(
        path,
        sep=delimiter,
        engine="python",
        dtype="string",
        keep_default_na=True,
        na_values=["", "NA", "N/A", "null", "None"],
    )
    return df


def maybe_unstructured_single_column(df: pd.DataFrame) -> bool:
    if df.shape[1] != 1:
        return False
    col = df.columns[0]
    s = df[col].dropna().astype(str)
    if s.empty:
        return True
    pat = re.compile(r"[,\t;|]")
    ratio = s.str.contains(pat).mean()
    return ratio > 0.3


def print_unstructured_view(path: str, max_lines_show: int = 50):
    print("\n=== UNSTRUCTURED CONTENT (raw text preview) ===")
    with open(path, "r", encoding="utf-8", newline="") as f:
        for i, line in enumerate(f):
            if i >= max_lines_show:
                break
            print(line.rstrip("\n"))

    with open(path, "r", encoding="utf-8", newline="") as f:
        chunk = f.read(200_000)
    tokens = re.findall(r"\b\w+\b", chunk.lower())
    print("\n=== UNSTRUCTURED TOKEN STATS (first 200KB) ===")
    print(f"Token count: {len(tokens)}")
    top = Counter(tokens).most_common(20)
    print("Top 20 tokens:")
    for tok, cnt in top:
        print(f"  {tok!r}: {cnt}")


def resolve_inventory_path() -> str:
    script_dir = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(script_dir, "data", "inventory.csv"),
        os.path.join(os.getcwd(), "data", "inventory.csv"),
        os.path.join(script_dir, "inventory.csv"),
        os.path.join(os.getcwd(), "inventory.csv"),
    ]
    for p in candidates:
        if os.path.isfile(p):
            return p
    return candidates[0]  # will raise downstream if missing


def main():
    path = resolve_inventory_path()

    read_raw_stats(path)

    delimiter = sniff_delimiter(path)
    print(f"\nDetected delimiter: {delimiter!r}")

    df = load_as_dataframe(path, delimiter=delimiter)

    if maybe_unstructured_single_column(df):
        print("\nDetected likely unstructured / single-column data.")
        summarize_dataframe(df, max_rows_show=15, max_cols_show=30)
        print_unstructured_view(path, max_lines_show=80)
    else:
        summarize_dataframe(df, max_rows_show=20, max_cols_show=40)

        print("\n=== FULL CONTENT (or limited if large) ===")
        if df.shape[0] <= 200 and df.shape[1] <= 50:
            print(df.to_string(index=False))
        else:
            print("(Dataset large; printing first 50 rows + 10 random rows.)")
            print("\n--- First 50 rows ---")
            print(df.head(50).to_string(index=False))
            print("\n--- 10 random rows (deterministic) ---")
            sample_n = min(10, df.shape[0])
            print(df.sample(n=sample_n, random_state=0).to_string(index=False))


if __name__ == "__main__":
    main()

